@page "/admin/projects"
@page "/projects"
@rendermode InteractiveServer
@inject IProjectService ProjectService
@inject ITechnologyService TechnologyService

<PageTitle>Projeler - Community Admin</PageTitle>

<div class="container-fluid py-4 px-lg-5">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 pb-3 border-bottom">
        <div>
            <h2 class="fw-bold mb-1" style="letter-spacing: -0.5px;">
                <span class="material-symbols-outlined text-primary me-2" style="font-size: 28px;">folder_open</span>Projeler
            </h2>
            <p class="text-muted mb-0 small">Topluluk bünyesinde geliştirilen açık kaynak ve Ar-Ge projelerini organize edin.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-google-primary" @onclick="OpenCreateModal">
                <span class="material-symbols-outlined" style="font-size: 18px;">add</span> Yeni Proje
            </button>
        </div>
    </div>

    <!-- Alert / Toast -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
            <span class="material-symbols-outlined text-success" style="font-size: 20px;">check_circle</span>
            <div>@statusMessage</div>
            <button type="button" class="btn-close ms-auto" @onclick="() => statusMessage = null"></button>
        </div>
    }

    <!-- Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-4">
            <div class="g-card p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 rounded-circle d-flex align-items-center justify-content-center" style="background-color: var(--google-blue-surface); color: var(--google-blue);">
                        <span class="material-symbols-outlined" style="font-size: 24px;">folder</span>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Toplam Proje</div>
                        <div class="h4 fw-bold mb-0">@(projects?.Count ?? 0)</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-4">
            <div class="g-card p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 rounded-circle d-flex align-items-center justify-content-center" style="background-color: var(--google-yellow-surface); color: #B06000;">
                        <span class="material-symbols-outlined" style="font-size: 24px;">star</span>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Öne Çıkanlar</div>
                        <div class="h4 fw-bold mb-0">@(projects?.Count(p => p.IsFeatured) ?? 0)</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-4">
            <div class="g-card p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 rounded-circle d-flex align-items-center justify-content-center" style="background-color: var(--google-green-surface); color: var(--google-green);">
                        <span class="material-symbols-outlined" style="font-size: 24px;">code</span>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Kullanılan Araçlar</div>
                        <div class="h4 fw-bold mb-0">@(technologies?.Count ?? 0)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter & Search Controls -->
    <div class="g-card mb-4 p-3 bg-white d-flex flex-wrap align-items-center justify-content-between gap-3">
        <!-- Filter Chips -->
        <div class="d-flex flex-wrap align-items-center gap-2">
            <button class="btn btn-sm rounded-pill px-3 fw-medium @(selectedFilter == "All" ? "btn-dark text-white" : "btn-light border")" 
                    @onclick='() => selectedFilter = "All"'>
                Tümü (@(projects?.Count ?? 0))
            </button>
            <button class="btn btn-sm rounded-pill px-3 fw-medium @(selectedFilter == "Featured" ? "btn-dark text-white" : "btn-light border")" 
                    @onclick='() => selectedFilter = "Featured"'>
                <span class="chip-status yellow p-0 me-1" style="background:transparent;"><i class="bi bi-star-fill text-warning"></i></span> Öne Çıkanlar
            </button>
            @if (technologies != null)
            {
                @foreach (var tech in technologies.Take(4))
                {
                    <button class="btn btn-sm rounded-pill px-3 fw-medium @(selectedTechId == tech.Id ? "btn-dark text-white" : "btn-light border")" 
                            @onclick="() => ToggleTechFilter(tech.Id)">
                        <span style="display:inline-block; width:6px; height:6px; border-radius:50%; background-color:@(tech.ColorHex ?? "#4285F4"); margin-right:4px;"></span>
                        @tech.Name
                    </button>
                }
            }
        </div>

        <!-- Search Input -->
        <div class="position-relative" style="min-width: 250px;">
            <span class="material-symbols-outlined position-absolute top-50 start-0 translate-middle-y ms-3 text-muted" style="font-size: 18px;">search</span>
            <input type="text" class="form-control rounded-pill border-0 ps-5 small" style="background-color: #F1F3F4;" placeholder="Proje veya teknoloji ara..." @bind="tableSearch" @bind:event="oninput" />
        </div>
    </div>

    <!-- Projects Table Card -->
    <div class="g-card overflow-hidden">
        <div class="table-responsive">
            <table class="g-table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Proje</th>
                        <th>Açıklama</th>
                        <th>Kullanılan Teknolojiler</th>
                        <th>Durum</th>
                        <th>Tarih</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <div class="spinner-border spinner-border-sm text-primary me-2"></div> Yükleniyor...
                            </td>
                        </tr>
                    }
                    else if (FilteredTableProjects == null || !FilteredTableProjects.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <span class="material-symbols-outlined d-block fs-1 mb-2 text-secondary">inventory_2</span>
                                Henüz proje bulunamadı veya arama sonucu boş.
                                <div class="mt-2">
                                    <button class="btn btn-google-primary btn-sm" @onclick="OpenCreateModal">+ İlk Projeyi Ekle</button>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var proj in FilteredTableProjects)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@proj.ImageUrl" alt="@proj.Name" class="rounded-3 object-fit-cover shadow-sm" style="width: 44px; height: 44px; border: 1px solid var(--google-border);"
                                             onerror="this.src='https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=120&q=80';" />
                                        <div>
                                            <div class="fw-bold text-dark">@proj.Name</div>
                                            <div class="d-flex gap-2 small text-muted">
                                                @if (!string.IsNullOrEmpty(proj.GitHubUrl))
                                                {
                                                    <a href="@proj.GitHubUrl" target="_blank" class="text-decoration-none text-muted d-flex align-items-center gap-1">
                                                        <i class="bi bi-github"></i> Repo
                                                    </a>
                                                }
                                                @if (!string.IsNullOrEmpty(proj.LiveDemoUrl))
                                                {
                                                    <a href="@proj.LiveDemoUrl" target="_blank" class="text-decoration-none text-primary d-flex align-items-center gap-1">
                                                        <span class="material-symbols-outlined" style="font-size: 14px;">open_in_new</span> Canlı
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="text-truncate text-muted small" style="max-width: 260px;" title="@proj.Description">
                                        @proj.Description
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1" style="max-width: 220px;">
                                        @foreach (var tech in proj.Technologies)
                                        {
                                            <span class="badge bg-light text-dark border rounded-pill px-2 py-1 small fw-normal">
                                                <span style="background-color: @(tech.ColorHex ?? "#4285F4"); display:inline-block; width:6px; height:6px; border-radius:50%; margin-right:4px;"></span>
                                                @tech.Name
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @if (proj.IsFeatured)
                                    {
                                        <span class="chip-status yellow"><i class="bi bi-star-fill text-warning me-1"></i> Öne Çıkan</span>
                                    }
                                    else
                                    {
                                        <span class="chip-status blue">Aktif</span>
                                    }
                                </td>
                                <td>
                                    <span class="text-muted small">@proj.CreatedAt.ToString("MMM yyyy")</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-1">
                                        <button class="btn-google-icon" title="Düzenle" @onclick="() => OpenEditModal(proj)">
                                            <span class="material-symbols-outlined" style="font-size: 18px;">edit</span>
                                        </button>
                                        <button class="btn-google-icon" style="color: var(--google-red);" title="Sil" @onclick="() => ConfirmDeleteProject(proj.Id)">
                                            <span class="material-symbols-outlined" style="font-size: 18px;">delete</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ======================== PROJE EKLE / DÜZENLE MODAL ======================== -->
@if (showProjectModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(32, 33, 36, 0.6); backdrop-filter: blur(2px);">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header border-bottom py-3 px-4">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
                        <span class="material-symbols-outlined text-primary">@(isEditing ? "edit" : "add_circle")</span>
                        @(isEditing ? "Projeyi Düzenle" : "Yeni Proje Oluştur")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseProjectModal"></button>
                </div>

                <div class="modal-body p-4">
                    @if (isEditing)
                    {
                        <EditForm Model="editModel" OnValidSubmit="HandleUpdateProject">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger small mb-3" />

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Proje Adı *</label>
                                <InputText @bind-Value="editModel.Name" class="form-control g-input w-100" placeholder="Örn: Kampüs Rehberi Mobil Uygulaması" />
                                <ValidationMessage For="() => editModel.Name" class="text-danger small" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Açıklama *</label>
                                <InputTextArea @bind-Value="editModel.Description" rows="3" class="form-control g-input w-100" placeholder="Projenin amacını, hedeflerini ve özelliklerini açıklayın..." />
                                <ValidationMessage For="() => editModel.Description" class="text-danger small" />
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">GitHub Repo URL</label>
                                    <InputText @bind-Value="editModel.GitHubUrl" class="form-control g-input w-100" placeholder="https://github.com/..." />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">Canlı Demo / Web URL</label>
                                    <InputText @bind-Value="editModel.LiveDemoUrl" class="form-control g-input w-100" placeholder="https://..." />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Kapak Görseli URL</label>
                                <InputText @bind-Value="editModel.ImageUrl" class="form-control g-input w-100" placeholder="https://images.unsplash.com/..." />
                            </div>

                            <!-- Technology Multi-Selection -->
                            <div class="mb-3">
                                <label class="form-label small fw-semibold d-block">Kullanılan Teknolojiler</label>
                                <div class="d-flex flex-wrap gap-2 p-3 bg-light rounded-3 border">
                                    @if (technologies != null && technologies.Any())
                                    {
                                        @foreach (var tech in technologies)
                                        {
                                            var isChecked = editModel.SelectedTechnologyIds.Contains(tech.Id);
                                            <div class="form-check form-check-inline m-0">
                                                <input class="form-check-input" type="checkbox" id="@($"edit-tech-{tech.Id}")"
                                                       checked="@isChecked"
                                                       @onchange="(e) => ToggleTechSelection(editModel.SelectedTechnologyIds, tech.Id, e.Value)" />
                                                <label class="form-check-label small fw-medium" for="@($"edit-tech-{tech.Id}")">
                                                    @tech.Name
                                                </label>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Kayıtlı teknoloji yok. Önce Teknolojiler Paneli'nden teknoloji ekleyebilirsiniz.</span>
                                    }
                                </div>
                            </div>

                            <div class="form-check form-switch mb-4">
                                <InputCheckbox @bind-Value="editModel.IsFeatured" class="form-check-input" id="editIsFeatured" />
                                <label class="form-check-label small fw-semibold" for="editIsFeatured">Topluluk vitrininde ve listenin başında öne çıkar</label>
                            </div>

                            <div class="d-flex justify-content-end gap-2 border-top pt-3">
                                <button type="button" class="btn btn-google-secondary" @onclick="CloseProjectModal">İptal</button>
                                <button type="submit" class="btn btn-google-primary">Değişiklikleri Kaydet</button>
                            </div>
                        </EditForm>
                    }
                    else
                    {
                        <EditForm Model="createModel" OnValidSubmit="HandleCreateProject">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger small mb-3" />

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Proje Adı *</label>
                                <InputText @bind-Value="createModel.Name" class="form-control g-input w-100" placeholder="Örn: GDG Sakarya Portal" />
                                <ValidationMessage For="() => createModel.Name" class="text-danger small" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Açıklama *</label>
                                <InputTextArea @bind-Value="createModel.Description" rows="3" class="form-control g-input w-100" placeholder="Projenin amacını, hedeflerini ve özelliklerini açıklayın..." />
                                <ValidationMessage For="() => createModel.Description" class="text-danger small" />
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">GitHub Repo URL</label>
                                    <InputText @bind-Value="createModel.GitHubUrl" class="form-control g-input w-100" placeholder="https://github.com/..." />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold">Canlı Demo / Web URL</label>
                                    <InputText @bind-Value="createModel.LiveDemoUrl" class="form-control g-input w-100" placeholder="https://..." />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Kapak Görseli URL</label>
                                <InputText @bind-Value="createModel.ImageUrl" class="form-control g-input w-100" placeholder="https://images.unsplash.com/..." />
                            </div>

                            <!-- Technology Multi-Selection -->
                            <div class="mb-3">
                                <label class="form-label small fw-semibold d-block">Kullanılan Teknolojiler</label>
                                <div class="d-flex flex-wrap gap-2 p-3 bg-light rounded-3 border">
                                    @if (technologies != null && technologies.Any())
                                    {
                                        @foreach (var tech in technologies)
                                        {
                                            var isChecked = createModel.SelectedTechnologyIds.Contains(tech.Id);
                                            <div class="form-check form-check-inline m-0">
                                                <input class="form-check-input" type="checkbox" id="@($"create-tech-{tech.Id}")"
                                                       checked="@isChecked"
                                                       @onchange="(e) => ToggleTechSelection(createModel.SelectedTechnologyIds, tech.Id, e.Value)" />
                                                <label class="form-check-label small fw-medium" for="@($"create-tech-{tech.Id}")">
                                                    @tech.Name
                                                </label>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Kayıtlı teknoloji yok. Önce Teknolojiler Paneli'nden teknoloji ekleyebilirsiniz.</span>
                                    }
                                </div>
                            </div>

                            <div class="form-check form-switch mb-4">
                                <InputCheckbox @bind-Value="createModel.IsFeatured" class="form-check-input" id="createIsFeatured" />
                                <label class="form-check-label small fw-semibold" for="createIsFeatured">Topluluk vitrininde ve listenin başında öne çıkar</label>
                            </div>

                            <div class="d-flex justify-content-end gap-2 border-top pt-3">
                                <button type="button" class="btn btn-google-secondary" @onclick="CloseProjectModal">İptal</button>
                                <button type="submit" class="btn btn-google-primary">Projeyi Kaydet</button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ProjectDto>? projects;
    private List<TechnologyDto>? technologies;
    private bool isLoading = true;
    private string? statusMessage;
    private string tableSearch = string.Empty;
    private string selectedFilter = "All";
    private int? selectedTechId = null;

    private bool showProjectModal = false;
    private bool isEditing = false;
    private CreateProjectDto createModel = new();
    private UpdateProjectDto editModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        technologies = await TechnologyService.GetAllAsync();
        projects = await ProjectService.GetAllAsync();
        isLoading = false;
    }

    private IEnumerable<ProjectDto>? FilteredTableProjects
    {
        get
        {
            if (projects == null) return null;
            var list = projects.AsEnumerable();

            if (selectedFilter == "Featured")
            {
                list = list.Where(p => p.IsFeatured);
            }

            if (selectedTechId.HasValue)
            {
                list = list.Where(p => p.Technologies.Any(t => t.Id == selectedTechId.Value));
            }

            if (!string.IsNullOrWhiteSpace(tableSearch))
            {
                var term = tableSearch.Trim().ToLower();
                list = list.Where(p =>
                    p.Name.ToLower().Contains(term) ||
                    p.Description.ToLower().Contains(term) ||
                    p.Technologies.Any(t => t.Name.ToLower().Contains(term)));
            }

            return list;
        }
    }

    private void ToggleTechFilter(int techId)
    {
        if (selectedTechId == techId)
            selectedTechId = null;
        else
            selectedTechId = techId;
    }

    private void OpenCreateModal()
    {
        createModel = new CreateProjectDto();
        isEditing = false;
        showProjectModal = true;
    }

    private void OpenEditModal(ProjectDto project)
    {
        editModel = new UpdateProjectDto
        {
            Id = project.Id,
            Name = project.Name,
            Description = project.Description,
            ImageUrl = project.ImageUrl,
            GitHubUrl = project.GitHubUrl,
            LiveDemoUrl = project.LiveDemoUrl,
            IsFeatured = project.IsFeatured,
            SelectedTechnologyIds = project.Technologies.Select(t => t.Id).ToList()
        };
        isEditing = true;
        showProjectModal = true;
    }

    private void CloseProjectModal()
    {
        showProjectModal = false;
    }

    private void ToggleTechSelection(List<int> selectedList, int techId, object? isChecked)
    {
        bool selected = isChecked is bool b && b;
        if (selected)
        {
            if (!selectedList.Contains(techId)) selectedList.Add(techId);
        }
        else
        {
            selectedList.Remove(techId);
        }
    }

    private async Task HandleCreateProject()
    {
        await ProjectService.CreateAsync(createModel);
        statusMessage = $"'{createModel.Name}' başarıyla oluşturuldu.";
        CloseProjectModal();
        await LoadDataAsync();
    }

    private async Task HandleUpdateProject()
    {
        await ProjectService.UpdateAsync(editModel);
        statusMessage = $"'{editModel.Name}' başarıyla güncellendi.";
        CloseProjectModal();
        await LoadDataAsync();
    }

    private async Task ConfirmDeleteProject(int id)
    {
        var proj = projects?.FirstOrDefault(p => p.Id == id);
        await ProjectService.DeleteAsync(id);
        statusMessage = $"'{proj?.Name ?? "Proje"}' silindi.";
        await LoadDataAsync();
    }
}
