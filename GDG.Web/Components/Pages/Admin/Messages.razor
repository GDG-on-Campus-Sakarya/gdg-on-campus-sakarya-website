@page "/admin/messages"
@rendermode InteractiveServer
@inject IContactService ContactService

<PageTitle>Gelen Mesajlar - Community Admin</PageTitle>

<div class="container-fluid py-4 px-lg-5">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 pb-3 border-bottom">
        <div>
            <h2 class="fw-bold mb-1" style="letter-spacing: -0.5px;">
                <span class="material-symbols-outlined text-primary me-2" style="font-size: 28px;">mail</span>İletişim Mesajları
            </h2>
            <p class="text-muted mb-0 small">Ziyaretçiler ve öğrencilerden web sitesi iletişim formu üzerinden gelen mesajlar.</p>
        </div>
    </div>

    <!-- Alert / Toast -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
            <span class="material-symbols-outlined text-success" style="font-size: 20px;">check_circle</span>
            <div>@statusMessage</div>
            <button type="button" class="btn-close ms-auto" @onclick="() => statusMessage = null"></button>
        </div>
    }

    <!-- Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-4">
            <div class="g-card p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 rounded-circle d-flex align-items-center justify-content-center" style="background-color: var(--google-blue-surface); color: var(--google-blue);">
                        <span class="material-symbols-outlined" style="font-size: 24px;">mail</span>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Toplam Mesaj</div>
                        <div class="h4 fw-bold mb-0">@(messages?.Count ?? 0)</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-4">
            <div class="g-card p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 rounded-circle d-flex align-items-center justify-content-center" style="background-color: var(--google-yellow-surface); color: #B06000;">
                        <span class="material-symbols-outlined" style="font-size: 24px;">mark_email_unread</span>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Okunmamış Mesaj</div>
                        <div class="h4 fw-bold mb-0 text-warning">@(messages?.Count(m => !m.IsRead) ?? 0)</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-4">
            <div class="g-card p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 rounded-circle d-flex align-items-center justify-content-center" style="background-color: var(--google-green-surface); color: var(--google-green);">
                        <span class="material-symbols-outlined" style="font-size: 24px;">mark_email_read</span>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Okunmuş Mesaj</div>
                        <div class="h4 fw-bold mb-0 text-success">@(messages?.Count(m => m.IsRead) ?? 0)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Messages Table Card -->
    <div class="g-card overflow-hidden">
        <div class="p-3 px-4 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2 bg-white">
            <h5 class="fw-bold mb-0 small text-uppercase text-muted">Mesaj Listesi</h5>
            <div class="position-relative" style="min-width: 250px;">
                <span class="material-symbols-outlined position-absolute top-50 start-0 translate-middle-y ms-3 text-muted" style="font-size: 18px;">search</span>
                <input type="text" class="form-control rounded-pill border-0 ps-5 small" style="background-color: #F1F3F4;" placeholder="Gönderen veya konu ara..." @bind="searchTerm" @bind:event="oninput" />
            </div>
        </div>

        <div class="table-responsive">
            <table class="g-table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Tarih</th>
                        <th>Gönderen</th>
                        <th>E-Posta</th>
                        <th>Konu</th>
                        <th>Durum</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <div class="spinner-border spinner-border-sm text-primary me-2"></div> Yükleniyor...
                            </td>
                        </tr>
                    }
                    else if (FilteredMessages == null || !FilteredMessages.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <span class="material-symbols-outlined d-block fs-1 mb-2 text-secondary">inbox</span>
                                Henüz gelen mesaj bulunmuyor.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var msg in FilteredMessages)
                        {
                            <tr class="@(!msg.IsRead ? "fw-semibold bg-light" : "")">
                                <td class="ps-4 text-muted small" style="white-space: nowrap;">
                                    @msg.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                                </td>
                                <td>@msg.FullName</td>
                                <td>
                                    <a href="@($"mailto:{msg.Email}")" class="text-decoration-none">@msg.Email</a>
                                </td>
                                <td>@msg.Subject</td>
                                <td>
                                    @if (!msg.IsRead)
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill">Okunmadı</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary rounded-pill">Okundu</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex align-items-center justify-content-end gap-1">
                                        <button class="btn btn-sm btn-outline-primary py-1 px-2 d-flex align-items-center gap-1" @onclick="() => ViewMessage(msg)">
                                            <span class="material-symbols-outlined" style="font-size: 16px;">visibility</span> İncele
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger py-1 px-2 d-flex align-items-center" @onclick="() => DeleteMessage(msg.Id)" title="Sil">
                                            <span class="material-symbols-outlined" style="font-size: 16px;">delete</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- View Message Modal -->
@if (selectedMessage != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header border-bottom py-3 px-4 bg-light">
                    <h5 class="modal-title fw-bold small text-uppercase text-muted">Mesaj Detayı</h5>
                    <button type="button" class="btn-close" @onclick="() => selectedMessage = null"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="text-muted small fw-semibold">Gönderen</label>
                        <div class="fw-bold">@selectedMessage.FullName</div>
                    </div>
                    <div class="mb-3">
                        <label class="text-muted small fw-semibold">E-Posta</label>
                        <div><a href="@($"mailto:{selectedMessage.Email}")">@selectedMessage.Email</a></div>
                    </div>
                    <div class="mb-3">
                        <label class="text-muted small fw-semibold">Tarih</label>
                        <div class="text-muted small">@selectedMessage.CreatedAt.ToString("dd MMMM yyyy HH:mm")</div>
                    </div>
                    <div class="mb-3">
                        <label class="text-muted small fw-semibold">Konu</label>
                        <div class="fw-semibold">@selectedMessage.Subject</div>
                    </div>
                    <div class="mb-0">
                        <label class="text-muted small fw-semibold">Mesaj</label>
                        <div class="p-3 bg-light rounded-3 mt-1" style="white-space: pre-wrap;">@selectedMessage.Message</div>
                    </div>
                </div>
                <div class="modal-footer border-top py-2 px-4">
                    <button type="button" class="btn btn-google-secondary" @onclick="() => selectedMessage = null">Kapat</button>
                    @if (!selectedMessage.IsRead)
                    {
                        <button type="button" class="btn btn-google-primary" @onclick="() => MarkSelectedAsRead()">Okundu Olarak İşaretle</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ContactMessageDto>? messages;
    private bool isLoading = true;
    private string? statusMessage;
    private string searchTerm = string.Empty;
    private ContactMessageDto? selectedMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        messages = await ContactService.GetAllMessagesAsync();
        isLoading = false;
    }

    private IEnumerable<ContactMessageDto>? FilteredMessages
    {
        get
        {
            if (messages == null) return null;
            if (string.IsNullOrWhiteSpace(searchTerm)) return messages;

            var term = searchTerm.Trim().ToLower();
            return messages.Where(m =>
                m.FullName.ToLower().Contains(term) ||
                m.Email.ToLower().Contains(term) ||
                m.Subject.ToLower().Contains(term) ||
                m.Message.ToLower().Contains(term));
        }
    }

    private async Task ViewMessage(ContactMessageDto msg)
    {
        selectedMessage = msg;
        if (!msg.IsRead)
        {
            await ContactService.MarkAsReadAsync(msg.Id);
            msg.IsRead = true;
        }
    }

    private async Task MarkSelectedAsRead()
    {
        if (selectedMessage != null)
        {
            await ContactService.MarkAsReadAsync(selectedMessage.Id);
            selectedMessage.IsRead = true;
            statusMessage = "Mesaj okundu olarak işaretlendi.";
            selectedMessage = null;
            await LoadDataAsync();
        }
    }

    private async Task DeleteMessage(int id)
    {
        var result = await ContactService.DeleteMessageAsync(id);
        if (result)
        {
            statusMessage = "Mesaj başarıyla silindi.";
            if (selectedMessage?.Id == id) selectedMessage = null;
            await LoadDataAsync();
        }
        else
        {
            statusMessage = "Mesaj silinirken bir sorun oluştu.";
        }
    }
}
