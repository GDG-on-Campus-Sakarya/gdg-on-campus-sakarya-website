@page "/admin/technologies"
@page "/technologies"
@rendermode InteractiveServer
@inject ITechnologyService TechnologyService

<PageTitle>Teknolojiler - Community Admin</PageTitle>

<div class="container-fluid py-4 px-lg-5">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 pb-3 border-bottom">
        <div>
            <h2 class="fw-bold mb-1" style="letter-spacing: -0.5px;">
                <span class="material-symbols-outlined text-warning me-2" style="font-size: 28px;">code</span>Teknolojiler
            </h2>
            <p class="text-muted mb-0 small">Topluluk projelerinde ve atölyelerinde kullanılan araçları, dilleri ve kütüphaneleri yönetin.</p>
        </div>
        <button class="btn btn-google-primary" @onclick="OpenCreateModal">
            <span class="material-symbols-outlined" style="font-size: 18px;">add</span> Yeni Teknoloji
        </button>
    </div>

    <!-- Alert / Toast -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
            <span class="material-symbols-outlined text-success" style="font-size: 20px;">check_circle</span>
            <div>@statusMessage</div>
            <button type="button" class="btn-close ms-auto" @onclick="() => statusMessage = null"></button>
        </div>
    }

    <!-- Stat & Quick Add Card -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="g-card p-4 h-100 d-flex flex-column justify-content-center">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 rounded-circle d-flex align-items-center justify-content-center" style="background-color: var(--google-yellow-surface); color: #B06000;">
                        <span class="material-symbols-outlined" style="font-size: 24px;">code</span>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Toplam Teknoloji</div>
                        <div class="h3 fw-bold mb-0">@(technologies?.Count ?? 0)</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="g-card p-4 h-100">
                <h6 class="fw-bold mb-3 small text-uppercase text-muted d-flex align-items-center gap-1">
                    <span class="material-symbols-outlined text-warning" style="font-size: 18px;">bolt</span> Hızlı Teknoloji Ekle
                </h6>
                <div class="row g-2">
                    <div class="col-md-5">
                        <input type="text" class="form-control g-input w-100" placeholder="Teknoloji Adı (örn: Docker, Flutter, PostgreSQL)" @bind="quickName" />
                    </div>
                    <div class="col-md-3">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-palette"></i></span>
                            <input type="color" class="form-control form-control-color w-100" @bind="quickColor" title="Renk seç" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <button class="btn btn-google-primary w-100 justify-content-center" @onclick="HandleQuickAdd" disabled="@string.IsNullOrWhiteSpace(quickName)">
                            <span class="material-symbols-outlined" style="font-size: 18px;">add</span> Hızlı Ekle
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Technologies Table -->
    <div class="g-card overflow-hidden">
        <div class="p-3 px-4 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2 bg-white">
            <h5 class="fw-bold mb-0 small text-uppercase text-muted">Kayıtlı Teknoloji Listesi</h5>
            <div class="position-relative" style="min-width: 250px;">
                <span class="material-symbols-outlined position-absolute top-50 start-0 translate-middle-y ms-3 text-muted" style="font-size: 18px;">search</span>
                <input type="text" class="form-control rounded-pill border-0 ps-5 small" style="background-color: #F1F3F4;" placeholder="Teknoloji ara..." @bind="searchTerm" @bind:event="oninput" />
            </div>
        </div>

        <div class="table-responsive">
            <table class="g-table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4" style="width: 80px;">Önizleme</th>
                        <th>Teknoloji Adı</th>
                        <th>Tema Rengi</th>
                        <th>İkon Sınıfı</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <div class="spinner-border spinner-border-sm text-primary me-2"></div> Yükleniyor...
                            </td>
                        </tr>
                    }
                    else if (FilteredTechnologies == null || !FilteredTechnologies.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <span class="material-symbols-outlined d-block fs-1 mb-2 text-secondary">code_off</span>
                                Henüz teknoloji eklenmedi veya arama sonucu bulunamadı.
                                <div class="mt-2">
                                    <button class="btn btn-google-primary btn-sm" @onclick="OpenCreateModal">+ İlk Teknolojiyi Ekle</button>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var tech in FilteredTechnologies)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="d-inline-flex align-items-center justify-content-center rounded-3 shadow-sm" 
                                          style="width: 38px; height: 38px; background-color: @(tech.ColorHex ?? "#4285F4"); color: white;">
                                        <i class="bi @(string.IsNullOrEmpty(tech.IconClass) ? "bi-code-slash" : tech.IconClass) fs-5"></i>
                                    </span>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark">@tech.Name</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border font-monospace px-2 py-1">
                                        <span class="d-inline-block rounded-circle me-1" style="width: 10px; height: 10px; background-color: @(tech.ColorHex ?? "#4285F4");"></span>
                                        @(tech.ColorHex ?? "#4285F4")
                                    </span>
                                </td>
                                <td>
                                    <span class="text-muted small font-monospace">@(tech.IconClass ?? "bi-code-slash")</span>
                                </td>
                                <td class="text-end pe-4">
                                    <button class="btn-google-icon" style="color: var(--google-red);" title="Sil" @onclick="() => DeleteTechnology(tech.Id)">
                                        <span class="material-symbols-outlined" style="font-size: 18px;">delete</span>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Yeni Teknoloji Modalı -->
@if (showCreateModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(32, 33, 36, 0.6); backdrop-filter: blur(2px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-bottom py-3 px-4">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
                        <span class="material-symbols-outlined text-warning">code</span> Yeni Teknoloji Ekle
                    </h5>
                    <button type="button" class="btn-close" @onclick="() => showCreateModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Teknoloji Adı *</label>
                        <input type="text" class="form-control g-input w-100" placeholder="Örn: PostgreSQL, Docker, TensorFlow" @bind="newTech.Name" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Tema Rengi</label>
                        <div class="d-flex align-items-center gap-2">
                            <input type="color" class="form-control form-control-color" @bind="newTech.ColorHex" />
                            <input type="text" class="form-control g-input font-monospace" @bind="newTech.ColorHex" placeholder="#4285F4" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">İkon Sınıfı (Bootstrap Icons / Devicon)</label>
                        <input type="text" class="form-control g-input font-monospace w-100" placeholder="bi-cpu, bi-database, bi-cloud..." @bind="newTech.IconClass" />
                        <div class="form-text small">Varsayılan: <code>bi-code-slash</code></div>
                    </div>
                </div>
                <div class="modal-footer border-top py-2 px-4">
                    <button type="button" class="btn btn-google-secondary" @onclick="() => showCreateModal = false">İptal</button>
                    <button type="button" class="btn btn-google-primary" @onclick="SaveNewTechnology" disabled="@string.IsNullOrWhiteSpace(newTech.Name)">Kaydet</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<TechnologyDto>? technologies;
    private bool isLoading = true;
    private string? statusMessage;
    private string searchTerm = string.Empty;

    private string quickName = string.Empty;
    private string quickColor = "#4285F4";

    private bool showCreateModal = false;
    private CreateTechnologyDto newTech = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        technologies = await TechnologyService.GetAllAsync();
        isLoading = false;
    }

    private IEnumerable<TechnologyDto>? FilteredTechnologies
    {
        get
        {
            if (technologies == null) return null;
            if (string.IsNullOrWhiteSpace(searchTerm)) return technologies;

            var term = searchTerm.Trim().ToLower();
            return technologies.Where(t => t.Name.ToLower().Contains(term));
        }
    }

    private void OpenCreateModal()
    {
        newTech = new CreateTechnologyDto
        {
            ColorHex = "#4285F4",
            IconClass = "bi-code-slash"
        };
        showCreateModal = true;
    }

    private async Task SaveNewTechnology()
    {
        if (string.IsNullOrWhiteSpace(newTech.Name)) return;

        await TechnologyService.CreateAsync(newTech);
        statusMessage = $"'{newTech.Name}' teknolojisi başarıyla eklendi.";
        showCreateModal = false;
        await LoadDataAsync();
    }

    private async Task HandleQuickAdd()
    {
        if (string.IsNullOrWhiteSpace(quickName)) return;

        await TechnologyService.CreateAsync(new CreateTechnologyDto
        {
            Name = quickName.Trim(),
            ColorHex = quickColor,
            IconClass = "bi-code-slash"
        });

        statusMessage = $"'{quickName}' teknolojisi başarıyla eklendi.";
        quickName = string.Empty;
        await LoadDataAsync();
    }

    private async Task DeleteTechnology(int id)
    {
        var item = technologies?.FirstOrDefault(t => t.Id == id);
        await TechnologyService.DeleteAsync(id);
        statusMessage = $"'{item?.Name ?? "Teknoloji"}' silindi.";
        await LoadDataAsync();
    }
}
