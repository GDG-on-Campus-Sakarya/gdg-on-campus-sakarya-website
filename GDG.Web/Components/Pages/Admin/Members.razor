        <div class="p-3 px-4 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2 bg-white">

            <h5 class="fw-bold mb-0 small text-uppercase text-muted">Üye Listesi</h5>

            <div class="position-relative" style="min-width: 250px;">

                <span class="material-symbols-outlined position-absolute top-50 start-0 translate-middle-y ms-3 text-muted" style="font-size: 18px;">search</span>

                <input type="text" class="form-control rounded-pill border-0 ps-5 small" style="background-color: #F1F3F4;" placeholder="Üye veya rol ara..." @bind="searchTerm" @bind:event="oninput" />

            </div>

        </div>

        <div class="table-responsive">

            <table class="g-table mb-0">

                <thead>

                    <tr>

                        <th class="ps-4">Üye Bilgisi</th>

                        <th>Rol / Unvan</th>

                        <th>Dahil Olduğu Projeler</th>

                        <th>Bağlantılar</th>

                        <th class="text-end pe-4">İşlemler</th>

                    </tr>

                </thead>

                <tbody>

                    @if (isLoading)

                    {

                        <tr>

                            <td colspan="5" class="text-center py-5 text-muted">

                                <div class="spinner-border spinner-border-sm text-primary me-2"></div> Yükleniyor...

                            </td>

                        </tr>

                    }

                    else if (FilteredMembers == null || !FilteredMembers.Any())

                    {

                        <tr>

                            <td colspan="5" class="text-center py-5 text-muted">

                                <span class="material-symbols-outlined d-block fs-1 mb-2 text-secondary">person_off</span>

                                Henüz üye eklenmedi veya arama sonucu bulunamadı.

                                <div class="mt-2">

                                    <button class="btn btn-google-primary btn-sm" @onclick="OpenCreateModal">+ İlk Üyeyi Ekle</button>

                                </div>

                            </td>

                        </tr>

                    }

                    else

                    {

                        @foreach (var m in FilteredMembers)

                        {

                            <tr>

                                <td class="ps-4">

                                    <div class="d-flex align-items-center gap-3">

                                        <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm"

                                             style="width: 38px; height: 38px; background: linear-gradient(135deg, #4285F4, #34A853); font-size: 0.85rem;">

                                            @(string.IsNullOrEmpty(m.FullName) ? "?" : m.FullName.Substring(0, 1).ToUpper())

                                        </div>

                                        <div>

                                            <div class="fw-bold text-dark">@m.FullName</div>

                                            <div class="text-muted small">@(m.Email ?? "E-posta belirtilmedi")</div>

                                        </div>

                                    </div>

                                </td>

                                <td>

                                    <span class="chip-status blue">

                                        @m.Role

                                    </span>

                                </td>

                                <td>

                                    <div class="d-flex flex-wrap gap-1" style="max-width: 280px;">

                                        @if (m.ProjectIds != null && m.ProjectIds.Any())

                                        {

                                            @foreach (var pId in m.ProjectIds)

                                            {

var proj = allProjects?.FirstOrDefault(p => p.Id == pId);

                                                if (proj != null)

                                                {

                                                    <span class="badge bg-light text-dark border rounded-pill small">

                                                        <span class="material-symbols-outlined text-muted me-1" style="font-size: 14px;">folder</span>@proj.Name

                                                    </span>

                                                }

                                            }

                                        }

                                        else

                                        {

                                            <span class="text-muted small fst-italic">Henüz atanmadı</span>

                                        }

                                    </div>

                                </td>

                                <td>

                                    <div class="d-flex gap-2">

                                        @if (!string.IsNullOrEmpty(m.GitHubUrl))

                                        {

                                            <a href="@m.GitHubUrl" target="_blank" class="btn-google-icon" title="GitHub">

                                                <i class="bi bi-github"></i>

                                            </a>

                                        }

                                        @if (!string.IsNullOrEmpty(m.LinkedInUrl))

                                        {

                                            <a href="@m.LinkedInUrl" target="_blank" class="btn-google-icon" title="LinkedIn">

                                                <i class="bi bi-linkedin text-primary"></i>

                                            </a>

                                        }

                                    </div>

                                </td>

                                <td class="text-end pe-4">

                                    <div class="d-inline-flex gap-1">

                                        <button class="btn-google-icon" title="Düzenle" @onclick="() => OpenEditModal(m)">

                                            <span class="material-symbols-outlined" style="font-size: 18px;">edit</span>

                                        </button>

                                        <button class="btn-google-icon" style="color: var(--google-red);" title="Sil" @onclick="() => DeleteMember(m.Id)">

                                            <span class="material-symbols-outlined" style="font-size: 18px;">delete</span>

                                        </button>

                                    </div>

                                </td>

                            </tr>

                        }

                    }

                </tbody>

            </table>

        </div>

    </div>

