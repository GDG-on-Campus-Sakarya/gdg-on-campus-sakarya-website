@code {

private List<MemberDto>? members;

private List<ProjectDto>? allProjects;

private List<TeamDto>? allTeams;

private const long MaxAvatarSizeBytes = 5 * 1024 * 1024;

private IBrowserFile? selectedAvatarFile;

private string? avatarMessage;

private bool avatarSelectionError;

private static readonly HashSet<string> AllowedAvatarContentTypes =

    new(StringComparer.OrdinalIgnoreCase)

    {

        "image/jpeg",

        "image/png",

        "image/webp"

    };

private bool isLoading = true;

private string? statusMessage;

private string searchTerm = string.Empty;

private bool showModal = false;

private bool isEditing = false;

private string? modalErrorMessage;

private bool isSaving = false;

private CreateMemberDto createModel = new();

private UpdateMemberDto editModel = new();

protected override async Task OnInitializedAsync()

    {

        await LoadDataAsync();

    }

private async Task LoadDataAsync()

    {

        isLoading = true;

        allProjects = await ProjectService.GetAllAsync();

        allTeams = await TeamService.GetAllAsync();

        members = await MemberService.GetAllAsync();

        isLoading = false;

    }

private IEnumerable<MemberDto>? FilteredMembers

    {

get

        {

            if (members == null) return null;

            if (string.IsNullOrWhiteSpace(searchTerm)) return members;

var term = searchTerm.Trim().ToLower();

            return members.Where(m =>

                m.FullName.ToLower().Contains(term) ||

                m.Role.ToLower().Contains(term) ||

                (m.Email != null && m.Email.ToLower().Contains(term)));

        }

    }

private void OpenCreateModal()

    {

        ResetAvatarSelection();
        modalErrorMessage = null;

        createModel = new CreateMemberDto

        {

            TeamId = allTeams?.FirstOrDefault()?.Id ?? 0

        };

        isEditing = false;

        showModal = true;

    }

private void OpenEditModal(MemberDto member)

    {

        ResetAvatarSelection();
        modalErrorMessage = null;

        editModel = new UpdateMemberDto

        {

            Id = member.Id,

            FullName = member.FullName,

            Role = member.Role,

            TeamId = member.TeamId,

            AvatarUrl = member.AvatarUrl,

            Email = member.Email,

            GitHubUrl = member.GitHubUrl,

            LinkedInUrl = member.LinkedInUrl,

            SelectedProjectIds = new List<int>(member.ProjectIds)

        };

        isEditing = true;

        showModal = true;

    }

private void OnAvatarSelected(InputFileChangeEventArgs args)

{

    selectedAvatarFile = null;

    avatarMessage = null;

    avatarSelectionError = false;

var file = args.File;

    if (file.Size <= 0)

    {

        avatarSelectionError = true;

        avatarMessage = "Seçilen dosya boş.";

        return;

    }

    if (file.Size > MaxAvatarSizeBytes)

    {

        avatarSelectionError = true;

        avatarMessage = "Fotoğraf en fazla 5 MB olabilir.";

        return;

    }

    if (!AllowedAvatarContentTypes.Contains(file.ContentType))

    {

        avatarSelectionError = true;

        avatarMessage = "Yalnızca JPG, PNG ve WebP dosyaları kabul edilir.";

        return;

    }

    selectedAvatarFile = file;

    avatarMessage = $"Seçildi: {file.Name}";

}

private async Task<string?> UploadSelectedAvatarAsync()

{

    if (selectedAvatarFile == null)

        return null;

    await using var stream =

        selectedAvatarFile.OpenReadStream(MaxAvatarSizeBytes);

    return await AvatarStorage.UploadMemberAvatarAsync(

        stream,

        selectedAvatarFile.ContentType);

}

private void ResetAvatarSelection()

{

    selectedAvatarFile = null;

    avatarMessage = null;

    avatarSelectionError = false;

}

private void ToggleProjectSelection(List<int> selectedList, int projId, object? isChecked)

    {

        bool selected = isChecked is bool b && b;

        if (selected)

        {

            if (!selectedList.Contains(projId)) selectedList.Add(projId);

        }

        else

        {

            selectedList.Remove(projId);

        }

    }

private async Task HandleCreateMember()
    {
        modalErrorMessage = null;

        if (createModel.TeamId <= 0)
        {
            modalErrorMessage = "Lütfen üye için geçerli bir çalışma grubu seçin.";
            return;
        }

        isSaving = true;

        try
        {
            if (selectedAvatarFile != null)
            {
                avatarMessage = "Fotoğraf yükleniyor...";
                await InvokeAsync(StateHasChanged);

                var uploadedAvatarUrl = await UploadSelectedAvatarAsync();

                if (string.IsNullOrWhiteSpace(uploadedAvatarUrl))
                {
                    modalErrorMessage = "Fotoğraf yüklenemedi. Lütfen tekrar deneyin.";
                    return;
                }

                createModel.AvatarUrl = uploadedAvatarUrl;
            }

            await MemberService.CreateAsync(createModel);

            statusMessage = $"'{createModel.FullName}' başarıyla eklendi.";
            ResetAvatarSelection();
            modalErrorMessage = null;
            showModal = false;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            modalErrorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task HandleUpdateMember()
    {
        modalErrorMessage = null;

        if (editModel.TeamId <= 0)
        {
            modalErrorMessage = "Lütfen üye için geçerli bir çalışma grubu seçin.";
            return;
        }

        isSaving = true;

        try
        {
            // Yalnızca yeni fotoğraf seçilmişse yükle.
            if (selectedAvatarFile != null)
            {
                avatarMessage = "Fotoğraf yükleniyor...";
                await InvokeAsync(StateHasChanged);

                var uploadedAvatarUrl = await UploadSelectedAvatarAsync();

                if (string.IsNullOrWhiteSpace(uploadedAvatarUrl))
                {
                    modalErrorMessage = "Fotoğraf yüklenemedi. Lütfen tekrar deneyin.";
                    return;
                }

                editModel.AvatarUrl = uploadedAvatarUrl;
            }

            avatarMessage = null;

            var success = await MemberService.UpdateAsync(editModel);

            if (!success)
            {
                modalErrorMessage = "Üye güncellenemedi. Kayıt mevcut olmayabilir.";
                return;
            }

            statusMessage = $"'{editModel.FullName}' başarıyla güncellendi.";
            ResetAvatarSelection();
            modalErrorMessage = null;
            showModal = false;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            modalErrorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteMember(int id)

    {

var m = members?.FirstOrDefault(x => x.Id == id);

var success = await MemberService.DeleteAsync(id);

        if (success)

        {

            statusMessage = $"'{m?.FullName ?? "Üye"}' silindi.";

            await LoadDataAsync();

        }

        else

        {

            statusMessage = "Üye silinemedi.";

        }

    }

}