@page "/admin/members"

@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Forms

@inject IMemberService MemberService

@inject IProjectService ProjectService

@inject ITeamService TeamService

@inject SupabaseStorageService AvatarStorage

<PageTitle>Üyeler - Community Admin</PageTitle>

<div class="container-fluid py-4 px-lg-5">

<!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 pb-3 border-bottom">

        <div>

            <h2 class="fw-bold mb-1" style="letter-spacing: -0.5px;">

                <span class="material-symbols-outlined text-success me-2" style="font-size: 28px;">group</span>Üyeler

            </h2>

            <p class="text-muted mb-0 small">Topluluk çekirdek ekibini, liderleri ve aktif proje geliştiricilerini yönetin.</p>

        </div>

        <button class="btn btn-google-primary" @onclick="OpenCreateModal">

            <span class="material-symbols-outlined" style="font-size: 18px;">person_add</span> Yeni Üye Ekle

        </button>

    </div>

<!-- Alert / Toast -->
    @if (!string.IsNullOrEmpty(statusMessage))

    {

        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">

            <span class="material-symbols-outlined text-success" style="font-size: 20px;">check_circle</span>

            <div>@statusMessage</div>

            <button type="button" class="btn-close ms-auto" @onclick="() => statusMessage = null"></button>

        </div>

    }

<!-- Stat Cards -->
    <div class="row g-3 mb-4">

        <div class="col-sm-6 col-xl-4">

            <div class="g-card p-3">

                <div class="d-flex align-items-center gap-3">

                    <div class="p-3 rounded-circle d-flex align-items-center justify-content-center" style="background-color: var(--google-green-surface); color: var(--google-green);">

                        <span class="material-symbols-outlined" style="font-size: 24px;">group</span>

                    </div>

                    <div>

                        <div class="text-muted small fw-medium">Toplam Kayıtlı Üye</div>

                        <div class="h4 fw-bold mb-0">@(members?.Count ?? 0)</div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-sm-6 col-xl-4">

            <div class="g-card p-3">

                <div class="d-flex align-items-center gap-3">

                    <div class="p-3 rounded-circle d-flex align-items-center justify-content-center" style="background-color: var(--google-blue-surface); color: var(--google-blue);">

                        <span class="material-symbols-outlined" style="font-size: 24px;">assignment_ind</span>

                    </div>

                    <div>

                        <div class="text-muted small fw-medium">Proje Görevlendirmeleri</div>

                        <div class="h4 fw-bold mb-0">@(members?.Sum(m => m.ProjectIds.Count) ?? 0)</div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-sm-6 col-xl-4">

            <div class="g-card p-3">

                <div class="d-flex align-items-center gap-3">

                    <div class="p-3 rounded-circle d-flex align-items-center justify-content-center" style="background-color: var(--google-yellow-surface); color: #B06000;">

                        <span class="material-symbols-outlined" style="font-size: 24px;">badge</span>

                    </div>

                    <div>

                        <div class="text-muted small fw-medium">Farklı Rol Sayısı</div>

                        <div class="h4 fw-bold mb-0">@(members?.Select(m => m.Role).Distinct().Count() ?? 0)</div>

                    </div>

                </div>

            </div>

        </div>

    </div>

<!-- Search & Members Table -->
