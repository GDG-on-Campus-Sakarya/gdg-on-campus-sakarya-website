@page "/admin"
@page "/admin/dashboard"
@rendermode InteractiveServer
@inject IProjectService ProjectService
@inject ITechnologyService TechnologyService
@inject IMemberService MemberService
@inject ITeamService TeamService
@inject IEventService EventService

<PageTitle>Dashboard - Community Admin</PageTitle>

<div class="container-fluid py-4 px-lg-5">
    <!-- Welcome Section (Google Cloud / Workspace inspired) -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 mb-2 rounded-pill bg-primary bg-opacity-10 text-primary small fw-semibold">
                <span style="width: 8px; height: 8px; border-radius: 50%; background-color: #4285F4; display: inline-block;"></span>
                GDG on Campus Sakarya
            </div>
            <h2 class="fw-bold mb-1" style="letter-spacing: -0.5px;">Merhaba, Enes 👋</h2>
            <p class="text-muted mb-0 small">İşte topluluğundaki projeler, ekipler ve etkinliklerin güncel durumu.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/admin/projects" class="btn btn-google-primary">
                <span class="material-symbols-outlined" style="font-size: 18px;">add</span> Proje Ekle
            </a>
            <a href="/admin/events" class="btn btn-google-secondary">
                <span class="material-symbols-outlined" style="font-size: 18px;">event</span> Yeni Etkinlik
            </a>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Yükleniyor...</span>
            </div>
            <p class="text-muted small mt-2">Dashboard verileri yükleniyor...</p>
        </div>
    }
    else
    {
        <!-- 6 Google Metric Cards -->
        <div class="row g-3 mb-4">
            <!-- Projects Card -->
            <div class="col-sm-6 col-xl-2">
                <div class="g-card p-3 h-100">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-medium">Projeler</span>
                        <span class="material-symbols-outlined" style="color: #4285F4; font-size: 20px;">folder_open</span>
                    </div>
                    <div class="h3 fw-bold mb-0 text-dark">@(projects?.Count ?? 0)</div>
                    <span class="text-muted small" style="font-size: 0.75rem;">Topluluk portföyü</span>
                </div>
            </div>

            <!-- Technologies Card -->
            <div class="col-sm-6 col-xl-2">
                <div class="g-card p-3 h-100">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-medium">Teknolojiler</span>
                        <span class="material-symbols-outlined" style="color: #FBBC04; font-size: 20px;">code</span>
                    </div>
                    <div class="h3 fw-bold mb-0 text-dark">@(technologies?.Count ?? 0)</div>
                    <span class="text-muted small" style="font-size: 0.75rem;">Kullanılan araçlar</span>
                </div>
            </div>

            <!-- Members Card -->
            <div class="col-sm-6 col-xl-2">
                <div class="g-card p-3 h-100">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-medium">Üyeler</span>
                        <span class="material-symbols-outlined" style="color: #34A853; font-size: 20px;">group</span>
                    </div>
                    <div class="h3 fw-bold mb-0 text-dark">@(members?.Count ?? 0)</div>
                    <span class="text-muted small" style="font-size: 0.75rem;">Aktif geliştirici</span>
                </div>
            </div>

            <!-- Teams Card -->
            <div class="col-sm-6 col-xl-2">
                <div class="g-card p-3 h-100">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-medium">Ekipler</span>
                        <span class="material-symbols-outlined" style="color: #EA4335; font-size: 20px;">groups</span>
                    </div>
                    <div class="h3 fw-bold mb-0 text-dark">@(teams?.Count ?? 0)</div>
                    <span class="text-muted small" style="font-size: 0.75rem;">Çalışma grubu</span>
                </div>
            </div>

            <!-- Upcoming Events Card -->
            <div class="col-sm-6 col-xl-2">
                <div class="g-card p-3 h-100">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-medium">Yaklaşan Etk.</span>
                        <span class="material-symbols-outlined" style="color: #4285F4; font-size: 20px;">calendar_month</span>
                    </div>
                    <div class="h3 fw-bold mb-0 text-primary">@(events?.Count(e => !e.IsPast) ?? 0)</div>
                    <span class="text-muted small" style="font-size: 0.75rem;">Aktif takvim</span>
                </div>
            </div>

            <!-- Completed Events Card -->
            <div class="col-sm-6 col-xl-2">
                <div class="g-card p-3 h-100">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-medium">Tamamlanan</span>
                        <span class="material-symbols-outlined" style="color: #5F6368; font-size: 20px;">task_alt</span>
                    </div>
                    <div class="h3 fw-bold mb-0 text-muted">@(events?.Count(e => e.IsPast) ?? 0)</div>
                    <span class="text-muted small" style="font-size: 0.75rem;">Geçmiş etkinlik</span>
                </div>
            </div>
        </div>

        <!-- Quick Overview Row (Recent Projects & Upcoming Events) -->
        <div class="row g-4 mb-4">
            <!-- Left: Recent Projects -->
            <div class="col-lg-7">
                <div class="g-card h-100 overflow-hidden">
                    <div class="p-3 px-4 border-bottom d-flex align-items-center justify-content-between bg-white">
                        <div class="d-flex align-items-center gap-2">
                            <span class="material-symbols-outlined text-primary" style="font-size: 20px;">folder_open</span>
                            <h6 class="fw-bold mb-0">Son Eklenen Projeler</h6>
                        </div>
                        <a href="/admin/projects" class="text-decoration-none small fw-semibold text-primary d-flex align-items-center gap-1">
                            Tümünü Gör <span class="material-symbols-outlined" style="font-size: 16px;">arrow_forward</span>
                        </a>
                    </div>

                    <div class="p-0">
                        @if (projects == null || !projects.Any())
                        {
                            <div class="text-center py-5 text-muted">
                                <span class="material-symbols-outlined d-block fs-1 mb-2 text-secondary">inventory_2</span>
                                Henüz proje eklenmedi.
                                <div class="mt-2">
                                    <a href="/admin/projects" class="btn btn-google-primary btn-sm">+ İlk Projeyi Ekle</a>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive mb-0">
                                <table class="g-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>Proje Adı</th>
                                            <th>Teknolojiler</th>
                                            <th>Durum</th>
                                            <th class="text-end">İşlem</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var proj in projects.Take(5))
                                        {
                                            <tr>
                                                <td>
                                                    <div class="fw-bold text-dark">@proj.Name</div>
                                                    <div class="text-muted small text-truncate" style="max-width: 220px;">@proj.Description</div>
                                                </td>
                                                <td>
                                                    <div class="d-flex flex-wrap gap-1">
                                                        @foreach (var t in proj.Technologies.Take(2))
                                                        {
                                                            <span class="badge bg-light text-dark border small fw-normal">@t.Name</span>
                                                        }
                                                        @if (proj.Technologies.Count > 2)
                                                        {
                                                            <span class="badge bg-light text-secondary border small">+@(proj.Technologies.Count - 2)</span>
                                                        }
                                                    </div>
                                                </td>
                                                <td>
                                                    @if (proj.IsFeatured)
                                                    {
                                                        <span class="chip-status yellow">Öne Çıkan</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="chip-status blue">Aktif</span>
                                                    }
                                                </td>
                                                <td class="text-end">
                                                    <a href="/admin/projects" class="btn-google-icon" title="Düzenle">
                                                        <span class="material-symbols-outlined" style="font-size: 18px;">arrow_forward</span>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Right: Upcoming Events & Mini Widgets -->
            <div class="col-lg-5">
                <div class="g-card h-100 overflow-hidden d-flex flex-column">
                    <div class="p-3 px-4 border-bottom d-flex align-items-center justify-content-between bg-white">
                        <div class="d-flex align-items-center gap-2">
                            <span class="material-symbols-outlined text-success" style="font-size: 20px;">event</span>
                            <h6 class="fw-bold mb-0">Yaklaşan Etkinlikler</h6>
                        </div>
                        <a href="/admin/events" class="text-decoration-none small fw-semibold text-primary d-flex align-items-center gap-1">
                            Tümünü Gör <span class="material-symbols-outlined" style="font-size: 16px;">arrow_forward</span>
                        </a>
                    </div>

                    <div class="p-3 flex-grow-1">
                        @if (events == null || !events.Any(e => !e.IsPast))
                        {
                            <div class="text-center py-5 text-muted">
                                <span class="material-symbols-outlined d-block fs-1 mb-2 text-secondary">event_busy</span>
                                Planlanan yaklaşan etkinlik bulunmuyor.
                                <div class="mt-2">
                                    <a href="/admin/events" class="btn btn-google-primary btn-sm">+ Yeni Etkinlik Planla</a>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-3">
                                @foreach (var ev in events.Where(e => !e.IsPast).Take(3))
                                {
                                    <div class="p-3 rounded-3 border d-flex align-items-center gap-3 bg-white">
                                        <div class="text-center p-2 rounded-3 bg-primary bg-opacity-10 text-primary" style="min-width: 50px;">
                                            <div class="fw-bold small">@ev.Date.ToString("MMM").ToUpper()</div>
                                            <div class="h5 fw-bold mb-0">@ev.Date.ToString("dd")</div>
                                        </div>
                                        <div class="flex-grow-1 overflow-hidden">
                                            <div class="fw-bold text-dark text-truncate">@ev.Title</div>
                                            <div class="text-muted small text-truncate">
                                                <i class="bi bi-geo-alt me-1"></i>@ev.Location
                                            </div>
                                        </div>
                                        <span class="chip-status green">Yaklaşıyor</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Bottom Row: Recent Members & Active Teams -->
        <div class="row g-4">
            <!-- Members Overview -->
            <div class="col-md-6">
                <div class="g-card p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold mb-0 d-flex align-items-center gap-2">
                            <span class="material-symbols-outlined text-info" style="font-size: 20px;">group</span>
                            Topluluk Üyeleri
                        </h6>
                        <a href="/admin/members" class="small fw-semibold text-primary text-decoration-none">Yönet</a>
                    </div>
                    @if (members == null || !members.Any())
                    {
                        <p class="text-muted small mb-0">Henüz üye kaydı bulunmuyor.</p>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var m in members.Take(8))
                            {
                                <div class="d-flex align-items-center gap-2 p-2 px-3 rounded-pill bg-light border small">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold" 
                                         style="width: 22px; height: 22px; background: #4285F4; font-size: 0.7rem;">
                                        @m.FullName.Substring(0, 1).ToUpper()
                                    </div>
                                    <span class="fw-medium text-dark">@m.FullName</span>
                                    <span class="text-muted" style="font-size: 0.75rem;">(@m.Role)</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Teams Overview -->
            <div class="col-md-6">
                <div class="g-card p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold mb-0 d-flex align-items-center gap-2">
                            <span class="material-symbols-outlined text-danger" style="font-size: 20px;">groups</span>
                            Çalışma Grupları & Ekipler
                        </h6>
                        <a href="/admin/teams" class="small fw-semibold text-primary text-decoration-none">Yönet</a>
                    </div>
                    @if (teams == null || !teams.Any())
                    {
                        <p class="text-muted small mb-0">Henüz ekip oluşturulmadı.</p>
                    }
                    else
                    {
                        <div class="row g-2">
                            @foreach (var t in teams.Take(4))
                            {
                                <div class="col-sm-6">
                                    <div class="p-3 rounded-3 border bg-light small">
                                        <div class="fw-bold text-dark">@t.Name</div>
                                        <div class="text-muted small mt-1">@(t.Members.Count) üye atanmış</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<ProjectDto>? projects;
    private List<TechnologyDto>? technologies;
    private List<MemberDto>? members;
    private List<TeamDto>? teams;
    private List<EventDto>? events;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        projects = await ProjectService.GetAllAsync();
        technologies = await TechnologyService.GetAllAsync();
        members = await MemberService.GetAllAsync();
        teams = await TeamService.GetAllAsync();
        events = await EventService.GetAllAsync();
        isLoading = false;
    }
}
