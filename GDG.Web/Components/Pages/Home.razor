@page "/"
@using GDG.Web.Models
@using GDG.Web.Services

<PageTitle>GDG on Campus Sakarya - Ana Sayfa</PageTitle>

<div class="home-wrapper">
    <!-- SECTION 1: HERO BANNER -->
    <section class="hero-section text-center">
        <div class="container-custom">
            <!-- GDG Symbol Logo -->
            <div class="hero-logo-box">
                <GdgBracketsLogo Width="100" Height="60" />
            </div>

            <!-- Main Heading -->
            <h1 class="hero-title">
                <span class="c-blue">GDG</span> <span class="c-red">on</span> <span class="c-yellow">Campus</span> <span class="c-green">Sakarya</span>
            </h1>

            <!-- Subtitle -->
            <p class="hero-subtitle">
                Merak eden, üreten ve paylaşan öğrencileri bir araya getiriyoruz. Geleceğin teknolojilerini birlikte keşfetmeye hazır mısın?
            </p>

            <!-- Hero Action Buttons -->
            <div class="hero-actions">
                <a href="projects" class="btn-hero-primary">
                    <span>Projeleri İncele</span>
                    <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
                    </svg>
                </a>
                <a href="events" class="btn-hero-secondary">
                    <span>Etkinliklere Göz At</span>
                </a>
            </div>

            <!-- Scroll Down Pill Indicator -->
            <div class="scroll-indicator" aria-hidden="true">
                <div class="scroll-dot"></div>
            </div>
        </div>
    </section>

    <!-- SECTION 2: TOP GRID (UPCOMING EVENT COUNTDOWN & QUICK STATS) -->
    <section class="section-padding">
        <div class="container-custom">
            <div class="top-grid">
                <!-- Left Main Countdown Card -->
                <div class="upcoming-card">
                    <div class="upcoming-tag">
                        <span class="dot-indicator"></span>
                        <span>@upcomingEvent.CategoryTag</span>
                    </div>

                    <h2 class="upcoming-title">@upcomingEvent.Title</h2>
                    <p class="upcoming-sub">İlk etkinliğimize kalan süre</p>

                    <!-- Countdown Boxes -->
                    <div class="countdown-row">
                        <div class="countdown-box">
                            <span class="cd-num">@days.ToString("D2")</span>
                            <span class="cd-label">Gün</span>
                        </div>
                        <div class="countdown-box">
                            <span class="cd-num">@hours.ToString("D2")</span>
                            <span class="cd-label">Saat</span>
                        </div>
                        <div class="countdown-box">
                            <span class="cd-num">@minutes.ToString("D2")</span>
                            <span class="cd-label">Dakika</span>
                        </div>
                        <div class="countdown-box">
                            <span class="cd-num">@seconds.ToString("D2")</span>
                            <span class="cd-label">Saniye</span>
                        </div>
                    </div>
                </div>

                <!-- Right Column Stacked Cards -->
                <div class="right-stats-stack">
                    <!-- Top Member Stat Card -->
                    <div class="stat-card green-stat-bg">
                        <div class="stat-header">
                            <div class="stat-icon-box">
                                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <line x1="18" y1="20" x2="18" y2="10"></line>
                                    <line x1="12" y1="20" x2="12" y2="4"></line>
                                    <line x1="6" y1="20" x2="6" y2="14"></line>
                                </svg>
                            </div>
                            <span class="growth-badge">+18% bu dönem</span>
                        </div>
                        <div class="stat-main">
                            <h3 class="stat-number">50+</h3>
                            <h4 class="stat-title">Aktif Üye</h4>
                        </div>
                        <p class="stat-desc">Birlikte öğrenen, paylaşan ve üreten bir topluluk.</p>
                    </div>

                    <!-- Bottom Discord Card -->
                    <div class="stat-card yellow-stat-bg">
                        <div class="discord-row">
                            <div class="discord-left">
                                <div class="discord-icon-box">
                                    <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true">
                                        <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .373-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.893.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
                                    </svg>
                                </div>
                                <div class="discord-texts">
                                    <h4 class="discord-title">Sohbete katıl, bağlantıda kal.</h4>
                                    <p class="discord-sub">Discord sunucumuzda yerini al.</p>
                                </div>
                            </div>
                            <a href="https://discord.gg" target="_blank" rel="noopener noreferrer" class="circle-arrow-btn" aria-label="Discord Sunucusuna Katıl">
                                <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SECTION 3: EVENTS LISTING -->
    <section class="section-padding">
        <div class="container-custom">
            <div class="section-header-row">
                <h2 class="section-heading">Etkinliklerimiz</h2>
                <a href="events" class="see-all-link">
                    <span>Tüm etkinlikler</span>
                    <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
                    </svg>
                </a>
            </div>

            @if (events != null && events.Any())
            {
                <div class="events-grid">
                    @foreach (var ev in events)
                    {
                        <EventCard @key="ev.Id" Item="ev" />
                    }
                </div>
            }
            else
            {
                <div class="empty-state-box">
                    <p>Yakında eklenecek yeni etkinlikler için takipte kalın!</p>
                </div>
            }
        </div>
    </section>

    <!-- SECTION 4: OUR TEAM -->
    <section class="section-padding">
        <div class="container-custom">
            <div class="section-header-row align-items-end">
                <div>
                    <span class="section-tag tag-red">BİZİ TANIYIN</span>
                    <h2 class="section-heading">Ekibimiz</h2>
                </div>
                <p class="section-side-desc">
                    Farklı disiplinlerden, aynı meraktan. Topluluğu birlikte büyütüyoruz.
                </p>
            </div>

            @if (members != null && members.Any())
            {
                <div class="members-grid">
                    @foreach (var m in members)
                    {
                        <MemberCard @key="m.Id" Item="m" />
                    }
                </div>
            }
            else
            {
                <div class="empty-state-box">
                    <p>Ekip üyeleri yakında listelenecektir.</p>
                </div>
            }
        </div>
    </section>

    <!-- SECTION 5: CLUB PROJECTS -->
    <section class="section-padding mb-5">
        <div class="container-custom">
            <div class="section-header-row align-items-end">
                <div>
                    <span class="section-tag tag-green">FİKİRDEN ÜRÜNE</span>
                    <h2 class="section-heading">Kulüp Projeleri</h2>
                </div>
                <p class="section-side-desc">
                    Teknolojiyi gerçek sorunlara çözüm üretmek için kullanıyoruz.
                </p>
            </div>

            @if (projects != null && projects.Any())
            {
                <div class="projects-grid">
                    @foreach (var p in projects)
                    {
                        <ProjectCard @key="p.Id" Item="p" />
                    }
                </div>
            }
            else
            {
                <div class="empty-state-box">
                    <p>Henüz proje bulunmamaktadır.</p>
                </div>
            }
        </div>
    </section>
</div>

@code {
    private EventViewModel upcomingEvent = new();
    private List<EventViewModel> events = new();
    private List<MemberViewModel> members = new();
    private List<ProjectViewModel> projects = new();

    private int days;
    private int hours;
    private int minutes;
    private int seconds;

    protected override void OnInitialized()
    {
        upcomingEvent = MockDataService.GetUpcomingEvent();
        events = MockDataService.GetEvents();
        members = MockDataService.GetMembers();
        projects = MockDataService.GetProjects();

        CalculateRemainingTime();
    }

    private void CalculateRemainingTime()
    {
        var diff = upcomingEvent.Date - DateTime.Now;
        if (diff.TotalSeconds > 0)
        {
            days = diff.Days;
            hours = diff.Hours;
            minutes = diff.Minutes;
            seconds = diff.Seconds;
        }
        else
        {
            days = 0;
            hours = 0;
            minutes = 0;
            seconds = 0;
        }
    }
}
