@page "/team"
@using GDG.Web.Models

@inject ITeamService TeamService
@inject NavigationManager Navigation

<PageTitle>Ekibimiz - GDG on Campus Sakarya</PageTitle>

<div class="team-page-wrapper">
    <!-- PAGE HERO -->
    <PageHeader Tag="BİZİ TANIYIN"
                TagColor="red"
                Title="Çekirdek Ekibimiz"
                Subtitle="Farklı disiplinlerden, aynı meraktan. Sakarya Üniversitesi'nde teknoloji ekosistemini birlikte büyütüyoruz.">
    </PageHeader>

    <div class="container-custom">
        <!-- TEAM FILTER TABS -->
<section class="team-filter-section">
    <div class="tabs-group" role="tablist">
        <button class="filter-tab @(selectedDepartment == "all" ? "active" : "")"
                @onclick='() => FilterDepartment("all")'
                role="tab"
                aria-selected="@(selectedDepartment == "all")">
            Tüm Ekipler (@teams.Count)
        </button>

        @foreach (var team in teams)
        {
            <button @key="team.Id"
                    class="filter-tab @(selectedDepartment == team.Name ? "active" : "")"
                    @onclick="() => FilterDepartment(team.Name)"
                    role="tab"
                    aria-selected="@(selectedDepartment == team.Name)">
                @team.Name (@team.Members.Count)
            </button>
        }
    </div>
</section>

        <!-- TEAMS AND MEMBERS -->
<section class="members-section" aria-label="Ekipler ve ekip üyeleri">

    @if (isLoading)
    {
        <div class="text-center py-5 text-muted">
            <div class="spinner-border spinner-border-sm text-primary me-2"></div>
            Ekipler yükleniyor...
        </div>
    }
    else if (!filteredTeams.Any())
    {
        <div class="empty-team-state">
            <p>Henüz bir ekip oluşturulmamış.</p>
        </div>
    }
    else
    {
        @foreach (var team in filteredTeams)
        {
            var teamMembers = GetTeamMembers(team);

            <section class="mb-5" @key="team.Id">
                <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-3">
                    <div>
                        <h2 class="h3 fw-bold mb-1">@team.Name</h2>

                        @if (!string.IsNullOrWhiteSpace(team.Description))
                        {
                            <p class="text-muted mb-0">@team.Description</p>
                        }
                    </div>

                    <span class="filter-tab active">
                        @teamMembers.Count Üye
                    </span>
                </div>

                @if (teamMembers.Any())
                {
                    <div class="members-grid">
                        @foreach (var member in teamMembers)
                        {
                            <MemberCard @key="member.Id" Item="member" />
                        }
                    </div>
                }
                else
                {
                    <div class="empty-team-state">
                        <p>Bu ekibe henüz üye eklenmemiş.</p>
                    </div>
                }
            </section>
        }
    }
</section>


        <!-- JOIN THE TEAM CTA -->
        <section class="team-join-cta">
            <div class="join-card">
                <div class="join-content">
                    <span class="section-kicker kicker-blue">ARAMIZA KATIL</span>
                    <h2 class="join-title">Topluluğun Geleceğini Birlikte İnşa Edelim</h2>
                    <p class="join-desc">
                        GDG on Campus Sakarya çekirdek ekibinde organizasyon, tasarım, yazılım geliştirme veya sponsorluk alanlarında aktif rol almak ister misin?
                    </p>
                    <div class="join-actions">
                        @* TODO(link): ekip lideri bekleniyor - Katılım linki teyit edildiğinde SiteLinks.JoinUrl güncellenecek *@
                        <a href="@SiteLinks.JoinUrl" target="_blank" rel="noopener noreferrer" class="btn-action-primary">
                            <span>Bize Katıl</span>
                            <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
                            </svg>
                        </a>
                        <a href="/contact"
   class="btn-action-outlined"
   @onclick="OpenContactPage"
   @onclick:preventDefault="true">
    <span>Soru Sor</span>
</a>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

@code {
    private List<TeamDto> teams = new();

    private string selectedDepartment = "all";

    private bool isLoading = true;

    private IEnumerable<TeamDto> filteredTeams =>
        selectedDepartment == "all"
            ? teams
            : teams.Where(t => string.Equals(
                t.Name,
                selectedDepartment,
                StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        try
        {
            teams = await TeamService.GetAllAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenContactPage()
{
    Navigation.NavigateTo("/contact", forceLoad: true);
}

    private void FilterDepartment(string department)
    {
        selectedDepartment = department;
    }

    private static List<MemberViewModel> GetTeamMembers(TeamDto team)
    {
        var colorPalette = new[]
        {
            "blue",
            "red",
            "yellow",
            "green"
        };

        return team.Members
            .OrderBy(m => m.FullName)
            .Select((member, index) => new MemberViewModel
            {
                Id = member.Id,
                FullName = member.FullName,
                Role = member.Role,

                // Her ekipte aynı üyenin kartı o ekibin
                // üyeliği üzerinden oluşturulur.
                TeamName = team.Name,

                AvatarUrl = member.AvatarUrl,
                GitHubUrl = member.GitHubUrl,
                LinkedInUrl = member.LinkedInUrl,

                CardColor = colorPalette[index % colorPalette.Length]
            })
            .ToList();
    }
}