@page "/team"
@using GDG.Web.Models
@inject IMemberService MemberService
@inject ITeamService TeamService

<PageTitle>Ekibimiz - GDG on Campus Sakarya</PageTitle>

<div class="team-page-wrapper">
    <!-- PAGE HERO -->
    <PageHeader Tag="BİZİ TANIYIN"
                TagColor="red"
                Title="Çekirdek Ekibimiz"
                Subtitle="Farklı disiplinlerden, aynı meraktan. Sakarya Üniversitesi'nde teknoloji ekosistemini birlikte büyütüyoruz.">
    </PageHeader>

    <div class="container-custom">
        <!-- TEAM FILTER TABS -->
        <section class="team-filter-section">
            <div class="tabs-group" role="tablist">
                <button class="filter-tab @(selectedDepartment == "all" ? "active" : "")" @onclick='() => FilterDepartment("all")' role="tab" aria-selected="@(selectedDepartment == "all")">
                    Tüm Ekip (@allMembers.Count)
                </button>
                <button class="filter-tab @(selectedDepartment == "Yönetim" ? "active" : "")" @onclick='() => FilterDepartment("Yönetim")' role="tab" aria-selected="@(selectedDepartment == "Yönetim")">
                    Liderler
                </button>
                <button class="filter-tab @(selectedDepartment == "Medya" ? "active" : "")" @onclick='() => FilterDepartment("Medya")' role="tab" aria-selected="@(selectedDepartment == "Medya")">
                    Sosyal Medya
                </button>
                <button class="filter-tab @(selectedDepartment == "Organizasyon" ? "active" : "")" @onclick='() => FilterDepartment("Organizasyon")' role="tab" aria-selected="@(selectedDepartment == "Organizasyon")">
                    Organizasyon
                </button>
                <button class="filter-tab @(selectedDepartment == "Sponsorluk" ? "active" : "")" @onclick='() => FilterDepartment("Sponsorluk")' role="tab" aria-selected="@(selectedDepartment == "Sponsorluk")">
                    Sponsorluk
                </button>
                <button class="filter-tab @(selectedDepartment == "Yazılım" ? "active" : "")" @onclick='() => FilterDepartment("Yazılım")' role="tab" aria-selected="@(selectedDepartment == "Yazılım")">
                    Proje
                </button>
 
          
            </div>
        </section>

        <!-- MEMBERS GRID -->
        <section class="members-section" aria-label="Ekip Üyeleri">
            @if (isLoading)
            {
                <div class="text-center py-5 text-muted">
                    <div class="spinner-border spinner-border-sm text-primary me-2"></div> Ekip üyeleri yükleniyor...
                </div>
            }
            else if (filteredMembers.Any())
            {
                <div class="members-grid">
                    @foreach (var member in filteredMembers)
                    {
                        <MemberCard @key="member.Id" Item="member" />
                    }
                </div>
            }
            else
            {
                <div class="empty-team-state">
                    <p>Bu departmanda henüz listelenen üye bulunmamaktadır.</p>
                </div>
            }
        </section>

        <!-- JOIN THE TEAM CTA -->
        <section class="team-join-cta">
            <div class="join-card">
                <div class="join-content">
                    <span class="section-kicker kicker-blue">ARAMIZA KATIL</span>
                    <h2 class="join-title">Topluluğun Geleceğini Birlikte İnşa Edelim</h2>
                    <p class="join-desc">
                        GDG on Campus Sakarya çekirdek ekibinde organizasyon, tasarım, yazılım geliştirme veya sponsorluk alanlarında aktif rol almak ister misin?
                    </p>
                    <div class="join-actions">
                        @* TODO(link): ekip lideri bekleniyor - Katılım linki teyit edildiğinde SiteLinks.JoinUrl güncellenecek *@
                        <a href="@SiteLinks.JoinUrl" target="_blank" rel="noopener noreferrer" class="btn-action-primary">
                            <span>Bize Katıl</span>
                            <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
                            </svg>
                        </a>
                        <a href="/contact" class="btn-action-outlined">
                            <span>Soru Sor</span>
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

@code {
    private List<MemberViewModel> allMembers = new();
    private List<TeamDto> teams = new();
    private string selectedDepartment = "all";
    private bool isLoading = true;

    private IEnumerable<MemberViewModel> filteredMembers =>
        selectedDepartment == "all"
            ? allMembers
            : allMembers.Where(m => string.Equals(m.TeamName, selectedDepartment, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        teams = await TeamService.GetAllAsync();
        var members = await MemberService.GetAllAsync();

        var teamDict = teams.ToDictionary(t => t.Id, t => t.Name);

        var colorPalette = new[] { "blue", "red", "yellow", "green" };

        allMembers = members.Select((m, idx) => new MemberViewModel
        {
            Id = m.Id,
            FullName = m.FullName,
            Role = m.Role,
            TeamName = teamDict.TryGetValue(m.TeamId, out var tn) ? tn : "Topluluk Ekibi",
            AvatarUrl = m.AvatarUrl,
            GitHubUrl = m.GitHubUrl,
            LinkedInUrl = m.LinkedInUrl,
            CardColor = colorPalette[idx % colorPalette.Length]
        }).ToList();

        isLoading = false;
    }

    private void FilterDepartment(string dept)
    {
        selectedDepartment = dept;
    }
}
