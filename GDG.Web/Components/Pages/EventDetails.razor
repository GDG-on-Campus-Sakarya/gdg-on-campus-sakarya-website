@page "/events/{Id:int}"
@using GDG.Web.Models
@using System.Globalization
@inject IEventService EventService

<PageTitle>@(eventItem?.Title ?? "Etkinlik Detayları") - GDG on Campus Sakarya</PageTitle>

<div class="event-details-page">

    <a href="/events" class="btn-action-primary event-back-button">
        <svg viewBox="0 0 20 20"
             width="16"
             height="16"
             fill="currentColor"
             aria-hidden="true"
             style="transform: rotate(180deg);">
            <path fill-rule="evenodd"
                  d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414L11.707 15.3a1 1 0 01-1.414-1.414L14.586 10H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
                  clip-rule="evenodd" />
        </svg>

        <span>Etkinliklere geri dön</span>
    </a>

    <div class="event-details-spacer"></div>

    @if (isLoading)
    {
        <div class="text-center py-5 text-muted">
            <div class="spinner-border spinner-border-sm text-primary me-2"></div>
            Etkinlik bilgileri yükleniyor...
        </div>
    }
    else if (eventItem == null)
    {
        <div class="event-details-content">
            <h2>Etkinlik bulunamadı</h2>
            <p>Aradığın etkinlik mevcut değil veya kaldırılmış olabilir.</p>
        </div>
    }
    else
    {
        <section class="event-details-header">
            <span class="event-category">
                @eventItem.CategoryTag
            </span>

            <h1>@eventItem.Title</h1>

            <p>@eventItem.Description</p>
        </section>

        @if (!string.IsNullOrWhiteSpace(eventItem.ImageUrl))
        {
            <section class="event-details-poster"
                     aria-label="@eventItem.Title etkinlik afişi">

                <img src="@eventItem.ImageUrl"
                     alt="@eventItem.Title etkinlik afişi"
                     class="event-details-poster-image"
                     loading="eager" />
            </section>
        }

        <section class="event-details-content">
            <h2>Etkinlik Bilgileri</h2>

            <p>
                <strong>Tarih:</strong>

                <span>
                    @(string.IsNullOrWhiteSpace(eventItem.FormattedDate)
                        ? eventItem.Date.ToString(
                            "dd MMMM yyyy",
                            new CultureInfo("tr-TR"))
                        : eventItem.FormattedDate)
                </span>
            </p>

            <p>
                <strong>Saat:</strong>

                <span>
                    @(string.IsNullOrWhiteSpace(eventItem.Time)
                        ? eventItem.Date.ToString("HH:mm")
                        : eventItem.Time)
                </span>
            </p>

            <p>
                <strong>Konum:</strong>

                <span>
                    @(string.IsNullOrWhiteSpace(eventItem.Location)
                        ? "SAÜ Kültür ve Kongre Merkezi"
                        : eventItem.Location)
                </span>
            </p>
        </section>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private EventViewModel? eventItem;
    private bool isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;

        var dto = await EventService.GetByIdAsync(Id);

        if (dto != null)
        {
            eventItem = new EventViewModel
            {
                Id = dto.Id,
                Title = dto.Title,
                Description = dto.Description,
                Date = dto.Date,

                FormattedDate = dto.Date.ToString(
                    "dd MMMM yyyy",
                    new CultureInfo("tr-TR")).ToUpper(),

                Time = dto.Date.ToString("HH:mm"),
                Location = dto.Location,

                CategoryTag = dto.IsPast
                    ? "TAMAMLANDI"
                    : "ETKİNLİK",

                CategoryColor = dto.IsPast
                    ? "green"
                    : "blue",

                ImageUrl = dto.ImageUrl
            };
        }
        else
        {
            eventItem = null;
        }

        isLoading = false;
    }
}