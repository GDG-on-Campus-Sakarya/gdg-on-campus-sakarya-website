@page "/contact"
@using System.ComponentModel.DataAnnotations

<PageTitle>İletişim - GDG on Campus Sakarya</PageTitle>

<div class="contact-page-wrapper">
    <!-- PAGE HERO -->
    <PageHeader Tag="İLETİŞİM"
                TagColor="yellow"
                Title="Bizimle İletişime Geçin"
                Subtitle="Sorularınız, etkinlik önerileriniz veya sponsorluk iş birlikleriniz için bize mesaj bırakabilirsiniz.">
    </PageHeader>

    <div class="container-custom">
        <div class="contact-grid">
            <!-- LEFT COLUMN: CONTACT DETAILS & SOCIALS -->
            <div class="contact-info-col">
                <div class="info-card">
                    <span class="section-kicker kicker-blue">TOPLULUK BİLGİLERİ</span>
                    <h2 class="info-title">Kapımız Her Zaman Açık</h2>
                    <p class="info-desc">
                        GDG on Campus Sakarya olarak her türlü soru, geri bildirim ve iş birliği teklifine açığız. Sosyal medya hesaplarımızdan veya formu doldurarak bize ulaşabilirsiniz.
                    </p>

                    <div class="info-items-list">
                        <!-- Location -->
                        <div class="info-item">
                            <div class="info-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                    <circle cx="12" cy="10" r="3"></circle>
                                </svg>
                            </div>
                            <div class="info-text">
                                <span class="info-label">Konum</span>
                                <span class="info-value">Sakarya Üniversitesi, Esentepe Kampüsü</span>
                                <span class="info-sub">Serdivan / Sakarya</span>
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="info-item">
                            <div class="info-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                    <polyline points="22,6 12,13 2,6"></polyline>
                                </svg>
                            </div>
                            <div class="info-text">
                                <span class="info-label">E-posta</span>
                                <a href="mailto:sakarya@gdgoncampus.dev" class="info-value-link">sakarya@gdgoncampus.dev</a>
                            </div>
                        </div>

                        <!-- Discord -->
                        <div class="info-item">
                            <div class="info-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                                    <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .373-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.893.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
                                </svg>
                            </div>
                            <div class="info-text">
                                <span class="info-label">Discord</span>
                                <a href="https://discord.gg" target="_blank" rel="noopener noreferrer" class="info-value-link">Topluluk Sunucusuna Katıl</a>
                            </div>
                        </div>
                    </div>

                    <!-- Social Icons -->
                    <div class="info-socials">
                        <span class="socials-label">Sosyal Medyada Biz</span>
                        <div class="social-row">
                            <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="social-circle-btn" aria-label="GitHub">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                                    <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
                                </svg>
                            </a>
                            <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="social-circle-btn" aria-label="LinkedIn">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                                    <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                                </svg>
                            </a>
                            <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="social-circle-btn" aria-label="Instagram">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN: CONTACT FORM -->
            <div class="contact-form-col">
                <div class="form-card">
                    @if (isSubmitted)
                    {
                        <div class="success-message-box" role="status">
                            <div class="success-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                            </div>
                            <h3 class="success-title">Mesajınız Alındı!</h3>
                            <p class="success-desc">
                                İletişim kurduğunuz için teşekkürler. Ekibimiz en kısa sürede <strong>@formModel.Email</strong> adresi üzerinden sizinle iletişime geçecektir.
                            </p>
                            <button class="btn-action-outlined mt-3" @onclick="ResetForm">
                                Yeni Mesaj Gönder
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="form-header">
                            <h2 class="form-title">Mesaj Bırakın</h2>
                            <p class="form-sub">Formu doldurarak ekibimize doğrudan ulaşabilirsiniz.</p>
                        </div>

                        <form @onsubmit="HandleSubmit" class="contact-form-inner">
                            <!-- Name -->
                            <div class="form-group">
                                <label for="fullName" class="form-label">Ad Soyad <span class="required-star">*</span></label>
                                <input type="text"
                                       id="fullName"
                                       class="form-control-custom @(showErrors && string.IsNullOrWhiteSpace(formModel.FullName) ? "is-invalid" : "")"
                                       placeholder="Örn: Ayşe Yılmaz"
                                       @bind="formModel.FullName"
                                       required />
                                @if (showErrors && string.IsNullOrWhiteSpace(formModel.FullName))
                                {
                                    <span class="field-error">Lütfen adınızı ve soyadınızı giriniz.</span>
                                }
                            </div>

                            <!-- Email -->
                            <div class="form-group">
                                <label for="email" class="form-label">E-posta Adresi <span class="required-star">*</span></label>
                                <input type="email"
                                       id="email"
                                       class="form-control-custom @(showErrors && string.IsNullOrWhiteSpace(formModel.Email) ? "is-invalid" : "")"
                                       placeholder="ad.soyad@ogr.sakarya.edu.tr"
                                       @bind="formModel.Email"
                                       required />
                                @if (showErrors && string.IsNullOrWhiteSpace(formModel.Email))
                                {
                                    <span class="field-error">Geçerli bir e-posta adresi giriniz.</span>
                                }
                            </div>

                            <!-- Subject / Topic -->
                            <div class="form-group">
                                <label for="subject" class="form-label">Konu</label>
                                <select id="subject" class="form-control-custom" @bind="formModel.Subject">
                                    <option value="Genel">Genel Soru / Bilgi</option>
                                    <option value="Etkinlik">Etkinlik & Konuşmacı</option>
                                    <option value="Proje">Proje & Açık Kaynak</option>
                                    <option value="Sponsorluk">Sponsorluk & İş Birliği</option>
                                    <option value="Diğer">Diğer</option>
                                </select>
                            </div>

                            <!-- Message -->
                            <div class="form-group">
                                <label for="message" class="form-label">Mesajınız <span class="required-star">*</span></label>
                                <textarea id="message"
                                          rows="5"
                                          class="form-control-custom @(showErrors && string.IsNullOrWhiteSpace(formModel.Message) ? "is-invalid" : "")"
                                          placeholder="Bize iletmek istediğiniz mesajınızı buraya yazın..."
                                          @bind="formModel.Message"
                                          required></textarea>
                                @if (showErrors && string.IsNullOrWhiteSpace(formModel.Message))
                                {
                                    <span class="field-error">Lütfen mesajınızı yazınız.</span>
                                }
                            </div>

                            <!-- Submit Button -->
                            <button type="submit" class="btn-action-primary btn-submit">
                                <span>Gönder</span>
                                <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
                                </svg>
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private ContactFormModel formModel = new();
    private bool isSubmitted = false;
    private bool showErrors = false;

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(formModel.FullName) ||
            string.IsNullOrWhiteSpace(formModel.Email) ||
            string.IsNullOrWhiteSpace(formModel.Message))
        {
            showErrors = true;
            return;
        }

        showErrors = false;
        isSubmitted = true;
    }

    private void ResetForm()
    {
        formModel = new ContactFormModel();
        isSubmitted = false;
        showErrors = false;
    }

    public class ContactFormModel
    {
        public string FullName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Subject { get; set; } = "Genel";
        public string Message { get; set; } = string.Empty;
    }
}
