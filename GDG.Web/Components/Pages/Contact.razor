@page "/contact"
@using System.Net.Mail
@inject ISiteSettingsService SiteSettings
@inject NavigationManager Navigation

<PageTitle>İletişim - @communityName</PageTitle>

<div class="contact-page-wrapper">
    <!-- PAGE HERO -->
    <PageHeader Tag="İLETİŞİM"
                TagColor="yellow"
                Title="Bizimle İletişime Geçin"
                Subtitle="Sorularınız, etkinlik önerileriniz veya sponsorluk iş birlikleriniz için bize mesaj bırakabilirsiniz.">
    </PageHeader>

    <div class="container-custom">
        <div class="contact-grid">
            <!-- LEFT COLUMN: CONTACT DETAILS & SOCIALS -->
            <div class="contact-info-col">
                <div class="info-card">
                    <span class="section-kicker kicker-blue">TOPLULUK BİLGİLERİ</span>
                    <h2 class="info-title">Kapımız Her Zaman Açık</h2>
                    <p class="info-desc">
                        @communityName olarak her türlü soru, geri bildirim ve iş birliği teklifine açığız. Sosyal medya hesaplarımızdan veya formu doldurarak bize ulaşabilirsiniz.
                    </p>

                    <div class="info-items-list">
                        <!-- Location -->
                        <div class="info-item">
                            <div class="info-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                    <circle cx="12" cy="10" r="3"></circle>
                                </svg>
                            </div>
                            <div class="info-text">
                                <span class="info-label">Konum</span>
                                <span class="info-value">@campusLocation</span>
                                <span class="info-sub">@universityName</span>
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="info-item">
                            <div class="info-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                    <polyline points="22,6 12,13 2,6"></polyline>
                                </svg>
                            </div>
                            <div class="info-text">
                                <span class="info-label">E-posta</span>
                                @if (!string.IsNullOrWhiteSpace(contactEmail))
                                {
                                    <a href="@($"mailto:{contactEmail}")" class="info-value-link">@contactEmail</a>
                                }
                                else
                                {
                                    <span class="info-value text-muted">Yakında duyurulacak</span>
                                }
                            </div>
                        </div>

                        <!-- Official community page (the Discord invite is not yet verified) -->
                        <div class="info-item">
                            <div class="info-icon" aria-hidden="true">
                                <span class="material-symbols-outlined" style="font-size: 22px;">groups</span>
                            </div>
                            <div class="info-text">
                                <span class="info-label">Topluluk</span>
                                <a href="@SiteLinks.JoinUrl" target="_blank" rel="noopener noreferrer" class="info-value-link">Resmi Topluluk Sayfası</a>
                            </div>
                        </div>
                    </div>

                    <!-- Social Icons -->
                    <div class="info-socials">
                        <span class="socials-label">Sosyal Medyada Biz</span>
                        <div class="social-row">
                            @if (!string.IsNullOrWhiteSpace(githubUrl))
                            {
                                <a href="@githubUrl" target="_blank" rel="noopener noreferrer" class="social-circle-btn" aria-label="GitHub">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                                    <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
                                </svg>
                            </a>
                            }
                            @if (!string.IsNullOrWhiteSpace(linkedInUrl))
                            {
                                <a href="@linkedInUrl" target="_blank" rel="noopener noreferrer" class="social-circle-btn" aria-label="LinkedIn">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                                    <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                                </svg>
                            </a>
                            }
                            @if (!string.IsNullOrWhiteSpace(instagramUrl))
                            {
                                <a href="@instagramUrl" target="_blank" rel="noopener noreferrer" class="social-circle-btn" aria-label="Instagram">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                                </svg>
                            </a>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN: CONTACT FORM -->
            <div class="contact-form-col">
                <div class="form-card">
                    @if (isSubmitted)
                    {
                        <div class="success-message-box" role="status">
                            <div class="success-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                            </div>
                            <h3 class="success-title">Mesajınız Alındı!</h3>
                            <p class="success-desc">
                                İletişim kurduğunuz için teşekkürler. Mesajınız sistemimize kaydedildi. E-posta bildirimi yapılandırılmadığından bu sayfa otomatik bir yanıt göndermez.
                            </p>
                            <button class="btn-action-outlined mt-3" @onclick="ResetForm">
                                Yeni Mesaj Gönder
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="form-header">
                            <h2 class="form-title">Mesaj Bırakın</h2>
                            <p class="form-sub">Formu doldurarak ekibimize doğrudan ulaşabilirsiniz.</p>
                        </div>

                        <form method="post" action="/api/contact" class="contact-form-inner">
                            <AntiforgeryToken />
                            <div aria-hidden="true" style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;">
                                <label for="companyWebsite">Bu alanı boş bırakın</label>
                                <input id="companyWebsite" name="companyWebsite" type="text" tabindex="-1" autocomplete="off" />
                            </div>
                            <!-- Name -->
                            <div class="form-group">
                                <label for="fullName" class="form-label">Ad Soyad <span class="required-star">*</span></label>
                                <input type="text"
                                       id="fullName"
                                       class="form-control-custom"
                                       placeholder="Örn: Ayşe Yılmaz"
                                       name="FullName"
                                       maxlength="100"
                                       required />
                            </div>

                            <!-- Email -->
                            <div class="form-group">
                                <label for="email" class="form-label">E-posta Adresi <span class="required-star">*</span></label>
                                <input type="email"
                                       id="email"
                                       class="form-control-custom"
                                       placeholder="ad.soyad@ogr.sakarya.edu.tr"
                                       name="Email"
                                       maxlength="254"
                                       required />
                            </div>

                            <!-- Subject / Topic -->
                            <div class="form-group">
                                <label for="subject" class="form-label">Konu</label>
                                <select id="subject" class="form-control-custom" name="Subject">
                                    <option value="Genel">Genel Soru / Bilgi</option>
                                    <option value="Etkinlik">Etkinlik &amp; Konuşmacı</option>
                                    <option value="Proje">Proje &amp; Açık Kaynak</option>
                                    <option value="Sponsorluk">Sponsorluk &amp; İş Birliği</option>
                                    <option value="Diğer">Diğer</option>
                                </select>
                            </div>

                            <!-- Message -->
                            <div class="form-group">
                                <label for="message" class="form-label">Mesajınız <span class="required-star">*</span></label>
                                <textarea id="message"
                                          rows="5"
                                          class="form-control-custom"
                                          placeholder="Bize iletmek istediğiniz mesajınızı buraya yazın..."
                                          name="Message"
                                          maxlength="2000"
                                          required></textarea>
                            </div>

                            <!-- Submit Button -->
                            <button type="submit" class="btn-action-primary btn-submit">
                                <span>Gönder</span>
                                    <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
                                        <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
                                    </svg>
                            </button>
                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <div class="alert alert-danger mt-3 small">@errorMessage</div>
                            }
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "status")]
    public string? Status { get; set; }

    private bool isSubmitted;
    private string? errorMessage;
    private string communityName = "GDG on Campus Sakarya";
    private string universityName = "Sakarya Üniversitesi";
    private string? contactEmail;
    private string? campusLocation;
    private string? githubUrl;
    private string? linkedInUrl;
    private string? instagramUrl;

    protected override async Task OnInitializedAsync()
    {
        var settings = await SiteSettings.GetAllSettingsAsync();
        communityName = string.IsNullOrWhiteSpace(settings.CommunityName) ? communityName : settings.CommunityName;
        universityName = string.IsNullOrWhiteSpace(settings.UniversityName) ? universityName : settings.UniversityName;
        campusLocation = string.IsNullOrWhiteSpace(settings.CampusLocation) ? null : settings.CampusLocation;
        contactEmail = IsValidEmail(settings.ContactEmail) ? settings.ContactEmail.Trim() : null;
        githubUrl = UrlSafety.GetSafeHttpUrl(settings.GitHubUrl);
        linkedInUrl = UrlSafety.GetSafeHttpUrl(settings.LinkedInUrl);
        instagramUrl = UrlSafety.GetSafeHttpUrl(settings.InstagramUrl);
    }

    protected override void OnParametersSet()
    {
        isSubmitted = string.Equals(Status, "success", StringComparison.OrdinalIgnoreCase);
        errorMessage = Status?.ToLowerInvariant() switch
        {
            "invalid" => "Form bilgileri doğrulanamadı. Lütfen alanları kontrol edip tekrar deneyin.",
            "error" => "Mesajınız şu anda kaydedilemedi. Lütfen daha sonra tekrar deneyin.",
            "rate_limited" => "Kısa sürede çok fazla mesaj gönderildi. Lütfen birkaç dakika sonra tekrar deneyin.",
            _ => null
        };
    }

    private static bool IsValidEmail(string? value)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length > 254)
            return false;

        try
        {
            var address = new System.Net.Mail.MailAddress(value.Trim());
            return string.Equals(address.Address, value.Trim(), StringComparison.OrdinalIgnoreCase);
        }
        catch (FormatException)
        {
            return false;
        }
    }

    private void ResetForm() => Navigation.NavigateTo("/contact", forceLoad: true);
}
