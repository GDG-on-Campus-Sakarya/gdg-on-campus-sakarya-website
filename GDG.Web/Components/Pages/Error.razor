@page "/Error"
@using System.Diagnostics

<PageTitle>Hata - GDG on Campus Sakarya</PageTitle>

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-5 p-4 p-md-5 bg-white">
                <div class="d-inline-flex align-items-center justify-content-center mx-auto mb-3 rounded-circle bg-danger bg-opacity-10 text-danger" style="width: 80px; height: 80px;">
                    <i class="bi bi-exclamation-triangle-fill fs-1"></i>
                </div>

                <h1 class="h3 fw-bold mb-2 text-danger">Beklenmeyen Bir Hata Oluştu</h1>
                <p class="text-muted small mb-4">
                    İsteğiniz işlenirken teknik bir problem meydana geldi. Lütfen daha sonra tekrar deneyiniz veya ana sayfaya dönünüz.
                </p>

                @if (ShowRequestId)
                {
                    <div class="p-2 mb-4 bg-light rounded-3 text-secondary small font-monospace">
                        <strong>İstek ID (Request ID):</strong> @RequestId
                    </div>
                }

                <div class="d-flex justify-content-center gap-2 mb-4">
                    <a href="/" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-house-door-fill me-1"></i> Ana Sayfa
                    </a>
                    <a href="/contact" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-envelope me-1"></i> Bize Bildir
                    </a>
                </div>

                <div class="text-start mt-3 pt-3 border-top small text-muted">
                    <p class="fw-semibold mb-1"><i class="bi bi-info-circle me-1"></i> Geliştirici Modu (Development Mode):</p>
                    <p class="mb-0 text-secondary" style="font-size: 0.8rem;">
                        Yerel hata ayıklama için <code>ASPNETCORE_ENVIRONMENT</code> değişkenini <code>Development</code> olarak ayarlayıp uygulamayı yeniden başlatabilirsiniz.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
