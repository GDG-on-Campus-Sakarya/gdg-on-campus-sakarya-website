@page "/projects"
@rendermode InteractiveServer
@inject IProjectService ProjectService
@inject ITechnologyService TechnologyService

<PageTitle>Projelerimiz - GDG on Campus Sakarya</PageTitle>

<div class="projects-page py-4">
    <!-- Header Section -->
    <div class="container mb-5 text-center">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 mb-3 rounded-pill bg-primary bg-opacity-10 text-primary fw-semibold small">
            <i class="bi bi-code-slash"></i> GDG Sakarya Projeleri
        </div>
        <h1 class="display-5 fw-bold mb-3">Kulüp Projelerimiz</h1>
        <p class="text-muted lead mx-auto" style="max-width: 680px;">
            Topluluğumuz bünyesinde geliştirilen açık kaynaklı yazılımlar, mobil uygulamalar, yapay zeka projeleri ve web platformları.
        </p>

        <!-- Search & Filter Controls -->
        <div class="row justify-content-center mt-4">
            <div class="col-md-6 col-lg-5 mb-3">
                <div class="input-group shadow-sm">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" 
                           class="form-control border-start-0 ps-0" 
                           placeholder="Proje veya teknoloji ara..." 
                           @bind="searchTerm" 
                           @bind:event="oninput" />
                    @if (!string.IsNullOrEmpty(searchTerm))
                    {
                        <button class="btn btn-outline-secondary border-start-0" type="button" @onclick="() => searchTerm = string.Empty">
                            <i class="bi bi-x"></i>
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- Technology Filter Chips -->
        <div class="d-flex flex-wrap justify-content-center gap-2 mt-2">
            <button class="btn btn-sm rounded-pill px-3 py-2 fw-medium @(selectedTechId == null ? "btn-primary" : "btn-light border")"
                    @onclick="() => FilterByTech(null)">
                <i class="bi bi-grid-fill me-1"></i> Tümü (@(allProjects?.Count ?? 0))
            </button>
            @if (technologies != null)
            {
                @foreach (var tech in technologies)
                {
                    var isSelected = selectedTechId == tech.Id;
                    <button class="btn btn-sm rounded-pill px-3 py-2 fw-medium @(isSelected ? "btn-dark text-white" : "btn-light border")"
                            @onclick="() => FilterByTech(tech.Id)">
                        <span class="badge-dot me-1" style="background-color: @(tech.ColorHex ?? "#4285F4"); display:inline-block; width:8px; height:8px; border-radius:50%;"></span>
                        @tech.Name
                    </button>
                }
            }
        </div>
    </div>

    <!-- Projects Grid -->
    <div class="container">
        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Yükleniyor...</span>
                </div>
                <p class="text-muted mt-2">Projeler yükleniyor...</p>
            </div>
        }
        else if (FilteredProjects == null || !FilteredProjects.Any())
        {
            <div class="text-center py-5 bg-light rounded-4 p-5 my-4">
                <i class="bi bi-folder2-open display-3 text-secondary mb-3"></i>
                <h4>Eşleşen proje bulunamadı</h4>
                <p class="text-muted">Arama filtrenizi temizleyerek veya farklı bir teknoloji seçerek tekrar deneyebilirsiniz.</p>
                <button class="btn btn-primary btn-sm rounded-pill mt-2" @onclick="ResetFilters">
                    Filtreleri Sıfırla
                </button>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var project in FilteredProjects)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden project-card transition-all">
                            <!-- Project Image -->
                            <div class="position-relative overflow-hidden project-img-wrapper" style="height: 200px; background-color: #f8f9fa;">
                                <img src="@project.ImageUrl" 
                                     alt="@project.Name" 
                                     class="w-100 h-100 object-fit-cover project-img"
                                     onerror="this.src='https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=800&q=80';" />

                                @if (project.IsFeatured)
                                {
                                    <span class="position-absolute top-0 start-0 m-3 badge bg-warning text-dark shadow-sm rounded-pill px-3 py-1 fw-bold">
                                        <i class="bi bi-star-fill text-dark me-1"></i> Öne Çıkan
                                    </span>
                                }
                            </div>

                            <!-- Card Body -->
                            <div class="card-body d-flex flex-column p-4">
                                <h5 class="card-title fw-bold text-dark mb-2">@project.Name</h5>
                                <p class="card-text text-muted small flex-grow-1 mb-3" style="line-height: 1.55;">
                                    @project.Description
                                </p>

                                <!-- Technology Badges -->
                                <div class="d-flex flex-wrap gap-1 mb-4">
                                    @foreach (var tech in project.Technologies)
                                    {
                                        <span class="badge bg-light text-dark border rounded-pill px-2 py-1 small fw-normal d-inline-flex align-items-center gap-1">
                                            <span style="background-color: @(tech.ColorHex ?? "#4285F4"); width: 6px; height: 6px; border-radius: 50%;"></span>
                                            @tech.Name
                                        </span>
                                    }
                                </div>

                                <!-- Action Buttons -->
                                <div class="d-flex align-items-center justify-content-between pt-3 border-top mt-auto">
                                    <div class="d-flex gap-2">
                                        @if (!string.IsNullOrWhiteSpace(project.GitHubUrl))
                                        {
                                            <a href="@project.GitHubUrl" target="_blank" rel="noopener noreferrer" 
                                               class="btn btn-outline-dark btn-sm rounded-pill px-3 d-flex align-items-center gap-1">
                                                <i class="bi bi-github"></i> GitHub
                                            </a>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(project.LiveDemoUrl))
                                        {
                                            <a href="@project.LiveDemoUrl" target="_blank" rel="noopener noreferrer" 
                                               class="btn btn-primary btn-sm rounded-pill px-3 d-flex align-items-center gap-1">
                                                <i class="bi bi-box-arrow-up-right"></i> Canlı Demo
                                            </a>
                                        }
                                    </div>
                                    <span class="text-muted small">
                                        <i class="bi bi-calendar3 me-1"></i> @project.CreatedAt.ToString("MMM yyyy")
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    .project-card {
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        border: 1px solid rgba(0, 0, 0, 0.05) !important;
    }
    .project-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.1) !important;
    }
    .project-img {
        transition: transform 0.35s ease;
    }
    .project-card:hover .project-img {
        transform: scale(1.05);
    }
</style>

@code {
    private List<ProjectDto>? allProjects;
    private List<TechnologyDto>? technologies;
    private int? selectedTechId = null;
    private string searchTerm = string.Empty;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        technologies = await TechnologyService.GetAllAsync();
        allProjects = await ProjectService.GetAllAsync();
        isLoading = false;
    }

    private void FilterByTech(int? techId)
    {
        selectedTechId = techId;
    }

    private void ResetFilters()
    {
        selectedTechId = null;
        searchTerm = string.Empty;
    }

    private IEnumerable<ProjectDto>? FilteredProjects
    {
        get
        {
            if (allProjects == null) return null;

            var filtered = allProjects.AsEnumerable();

            if (selectedTechId.HasValue)
            {
                filtered = filtered.Where(p => p.Technologies.Any(t => t.Id == selectedTechId.Value));
            }

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim().ToLower();
                filtered = filtered.Where(p => 
                    p.Name.ToLower().Contains(term) || 
                    p.Description.ToLower().Contains(term) ||
                    p.Technologies.Any(t => t.Name.ToLower().Contains(term)));
            }

            return filtered;
        }
    }
}
