@inject NavigationManager Navigation
@implements IDisposable

@* NavMenu Component (Interactive Mobile Drawer & Accessible Navigation) *@
<div class="nav-container container-custom" @onkeydown="HandleKeyDown">
    <!-- Brand Logo -->
    <a href="/" class="navbar-brand" aria-label="GDG on Campus Sakarya Ana Sayfa" @onclick="CloseMenu">
        <GdgBracketsLogo CssClass="gdg-logo-icon" Width="38" Height="24" />
        <div class="brand-text-group">
            <span class="brand-title">GDG on Campus</span>
            <span class="brand-subtitle">Sakarya</span>
        </div>
    </a>

    <!-- Accessible Mobile Menu Toggle Button (Touch target >= 44px) -->
    <button type="button"
            class="nav-toggle-btn @(isMenuOpen ? "open" : "")"
            aria-label="@(isMenuOpen ? "Menüyü Kapat" : "Menüyü Aç")"
            aria-expanded="@isMenuOpen"
            aria-controls="primary-nav-menu"
            @onclick="ToggleMenu">
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
    </button>

    <!-- Mobile Drawer Backdrop Overlay -->
    <div class="nav-backdrop @(isMenuOpen ? "visible" : "")"
         @onclick="CloseMenu"
         aria-hidden="true"></div>

    <!-- Navigation Drawer -->
    <nav id="primary-nav-menu"
         class="nav-menu @(isMenuOpen ? "open" : "")"
         aria-label="Ana Navigasyon">
        <ul class="nav-list">
            <li class="nav-item">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="CloseMenu" aria-current="@(IsActive("") ? "page" : null)">
                    Ana Sayfa
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="/events" @onclick="CloseMenu" aria-current="@(IsActive("events") ? "page" : null)">
                    Etkinlikler
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="/team" @onclick="CloseMenu" aria-current="@(IsActive("team") ? "page" : null)">
                    Ekibimiz
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="/projects" @onclick="CloseMenu" aria-current="@(IsActive("projects") ? "page" : null)">
                    Projeler
                </NavLink>
            </li>
        </ul>

        <!-- Right Action Button -->
        <div class="nav-actions">
            @* TODO(link): ekip lideri bekleniyor - Doğru katılım linki teyit edildiğinde SiteLinks.JoinUrl güncellenecek *@
            <a href="@SiteLinks.JoinUrl"
               target="_blank"
               rel="noopener noreferrer"
               class="btn-cta"
               @onclick="CloseMenu">
                <span>Bize Katıl</span>
                <svg class="btn-arrow" viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
                </svg>
            </a>
        </div>
    </nav>
</div>

@code {
    private bool isMenuOpen = false;
    private string currentRelativePath = string.Empty;

    protected override void OnInitialized()
    {
        UpdateCurrentPath();
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateCurrentPath();
        InvokeAsync(StateHasChanged);
    }

    private void UpdateCurrentPath()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var queryIndex = relative.IndexOf('?');
        if (queryIndex >= 0) relative = relative.Substring(0, queryIndex);
        var hashIndex = relative.IndexOf('#');
        if (hashIndex >= 0) relative = relative.Substring(0, hashIndex);
        currentRelativePath = relative.Trim('/');
    }

    private bool IsActive(string route)
    {
        var cleanRoute = route.Trim('/');
        if (string.IsNullOrEmpty(cleanRoute))
        {
            return string.IsNullOrEmpty(currentRelativePath);
        }
        return currentRelativePath.Equals(cleanRoute, StringComparison.OrdinalIgnoreCase)
            || currentRelativePath.StartsWith(cleanRoute + "/", StringComparison.OrdinalIgnoreCase);
    }

    private void ToggleMenu() => isMenuOpen = !isMenuOpen;

    private void CloseMenu() => isMenuOpen = false;

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && isMenuOpen)
        {
            CloseMenu();
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
