@* Footer Component - Site ayarlarını veritabanından okur *@
@inject ISiteSettingsService SiteSettings
@inject NavigationManager Navigation

<footer class="site-footer">
    <div class="container-custom">
        <div class="footer-top">
            <div class="footer-brand">
                <a href="/" class="footer-logo" aria-label="@_communityName">
                    <GdgBracketsLogo CssClass="brand-icon" Width="36" Height="22" />
                    <div class="brand-text">
                        <span class="brand-name">@_communityName</span>
                        <span class="brand-sub">@_universityName</span>
                    </div>
                </a>
                <p class="footer-desc">
                    @_communityName, @_universityName bünyesinde merak eden, üreten ve paylaşan öğrencileri bir araya getiriyor.
                </p>
            </div>

            <div class="footer-nav-group">
                <h2 class="footer-title">Hızlı Bağlantılar</h2>
                <ul class="footer-links">
                    <li><a href="/">Ana Sayfa</a></li>
                    <li><a href="/events">Etkinlikler</a></li>
                    <li><a href="/team">Ekibimiz</a></li>
                    <li><a href="/projects">Projeler</a></li>
                    <li><a href="/about">Hakkımızda</a></li>
                    <li>
    <a href="/contact"
       @onclick="OpenContactPage"
       @onclick:preventDefault="true">
        İletişim
    </a>
</li>
                    @if (!string.IsNullOrWhiteSpace(_communityDevUrl))
                    {
                        <li><a href="@_communityDevUrl" target="_blank" rel="noopener noreferrer">Resmi Topluluk Sayfası</a></li>
                    }
                </ul>
            </div>

            <div class="footer-social-group">
                <h2 class="footer-title">Topluluğumuza Katıl</h2>
                <p class="social-subtitle">@_communityName topluluğunun güncel duyuru ve çalışmalarını takip edin.</p>
                <div class="social-links">
                    <a href="@SiteLinks.JoinUrl" target="_blank" rel="noopener noreferrer" aria-label="Resmi Topluluk Sayfası" class="social-btn">
                        <span class="material-symbols-outlined" aria-hidden="true">groups</span>
                    </a>
                    @if (!string.IsNullOrWhiteSpace(_githubUrl))
                    {
                        <a href="@_githubUrl" target="_blank" rel="noopener noreferrer" aria-label="GitHub Organizasyonu" class="social-btn">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
                        </svg>
                    </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(_linkedInUrl))
                    {
                        <a href="@_linkedInUrl" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn Sayfası" class="social-btn">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                        </svg>
                    </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(_instagramUrl))
                    {
                        <a href="@_instagramUrl" target="_blank" rel="noopener noreferrer" aria-label="Instagram Hesabı" class="social-btn">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                        </svg>
                    </a>
                    }
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <p>&copy; @DateTime.Now.Year @_communityName. Tüm hakları saklıdır.</p>
            <p class="footer-credit">Google Developer Groups topluluğunun bağımsız bir öğrenci koludur.</p>
        </div>
    </div>
</footer>

@code {
    private string _communityName = "GDG on Campus Sakarya";
    private string _universityName = "Sakarya Üniversitesi";
    private string? _githubUrl;
    private string? _linkedInUrl;
    private string? _instagramUrl;
    private string? _communityDevUrl;

    protected override async Task OnInitializedAsync()
    {
        var settings = await SiteSettings.GetAllSettingsAsync();
        _communityName = string.IsNullOrWhiteSpace(settings.CommunityName) ? _communityName : settings.CommunityName;
        _universityName = string.IsNullOrWhiteSpace(settings.UniversityName) ? _universityName : settings.UniversityName;
        _githubUrl = UrlSafety.GetSafeHttpUrl(settings.GitHubUrl);
        _linkedInUrl = UrlSafety.GetSafeHttpUrl(settings.LinkedInUrl);
        _instagramUrl = UrlSafety.GetSafeHttpUrl(settings.InstagramUrl);
        _communityDevUrl = UrlSafety.GetSafeHttpUrl(settings.CommunityDevUrl);
    }

    private void OpenContactPage()
{
    Navigation.NavigateTo("/contact", forceLoad: true);
}
}
