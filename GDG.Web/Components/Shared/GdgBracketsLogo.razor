@* GDG chevron logo: left top red / bottom blue, right top green / bottom yellow *@
<svg class="@CssClass"
     viewBox="0 0 40 24"
     width="@Width"
     height="@Height"
     fill="none"
     xmlns="http://www.w3.org/2000/svg"
     aria-hidden="true">
    <path d="M10 2L2 12" stroke="var(--color-gdg-red)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M2 12L10 22" stroke="var(--color-gdg-blue)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M30 2L38 12" stroke="var(--color-gdg-green)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M38 12L30 22" stroke="var(--color-gdg-yellow)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
</svg>

@code {
    [Parameter]
    public string CssClass { get; set; } = string.Empty;

    [Parameter]
    public int Width { get; set; } = 36;

    [Parameter]
    public int Height { get; set; } = 22;
}
