@using GDG.Web.Models

@* EventCard Shared Presentation Component *@
@if (Item != null)
{
    <article class="event-card tint-@Item.CategoryColor">
        <!-- Visual Header Banner -->
        <div class="card-banner">
            <div class="banner-grid-overlay"></div>
            @if (!string.IsNullOrEmpty(Item.ImageUrl))
            {
                <img src="@Item.ImageUrl" alt="@Item.Title" class="banner-img" loading="lazy" />
            }
            else
            {
                <div class="banner-symbol">
                    @if (Item.CategoryColor == "red")
                    {
                        <span class="symbol-text text-red">AI</span>
                    }
                    @if (Item.CategoryColor == "yellow")
                    {
                        <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="symbol-icon text-yellow" aria-hidden="true">
                            <line x1="7" y1="17" x2="17" y2="7"></line>
                            <polyline points="7 7 17 7 17 17"></polyline>
                        </svg>
                    }
                    @if (Item.CategoryColor == "blue" || (Item.CategoryColor != "red" && Item.CategoryColor != "yellow"))
                    {
                        <span class="symbol-text text-blue">&lt;/&gt;</span>
                    }
                </div>
            }
        </div>

        <!-- Card Content Body -->
        <div class="card-body">
            <!-- Date Badge -->
            <div class="date-badge">
                <span>@Item.FormattedDate</span>
            </div>

            <!-- Event Title -->
            <h3 class="event-title" title="@Item.Title">
                @Item.Title
            </h3>

            <!-- Details List (Time & Location) -->
            <div class="event-meta">
                <div class="meta-item">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <span>@(string.IsNullOrWhiteSpace(Item.Time) ? "Saat belirtilmedi" : Item.Time)</span>
                </div>
                <div class="meta-item">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                    <span class="location-text" title="@Item.Location">@(string.IsNullOrWhiteSpace(Item.Location) ? "Konum belirtilmedi" : Item.Location)</span>
                </div>
            </div>
        </div>

        <!-- Card Footer Link -->
        <div class="card-footer">
            <a href="@(string.IsNullOrEmpty(Item.CalendarUrl) ? "#" : Item.CalendarUrl)" class="calendar-link">
                <span>Takvime ekle</span>
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
            </a>
        </div>
    </article>
}

@code {
    [Parameter, EditorRequired]
    public EventViewModel? Item { get; set; }
}
